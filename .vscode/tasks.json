{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run Matrix.Web",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Matrix.Web/Matrix.Web.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building.*$",
          "endsPattern": "^.*Now listening on: http://localhost:5290.*$"
        }
      }
    }
  ]
}
