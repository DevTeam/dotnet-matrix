<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);ASP0029</NoWarn>
        <OutputType>Exe</OutputType>
        <MatrixMode Condition="'$(MatrixMode)' == ''">Validation</MatrixMode>
        <DefineConstants Condition="'$(MatrixMode)' == 'Validation'">$(DefineConstants);MATRIX_VALIDATION</DefineConstants>
        <DefineConstants Condition="'$(MatrixMode)' == 'Benchmark'">$(DefineConstants);MATRIX_BENCHMARK</DefineConstants>
        <OutputPath>bin\$(MatrixMode)\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>obj\$(MatrixMode)\$(Configuration)\</IntermediateOutputPath>
        <MatrixModuleId>validation</MatrixModuleId>
        <MatrixModuleName>Validation</MatrixModuleName>
        <MatrixRunConfigurationPrefix>Validation</MatrixRunConfigurationPrefix>
        <MatrixReportDirectory>Validation</MatrixReportDirectory>
        <MatrixLibraryCatalogNamespace>Matrix.Validation.Infrastructure</MatrixLibraryCatalogNamespace>
        <ValidationModules_DataAnnotations>Ignore</ValidationModules_DataAnnotations>
        <ValidationModules_FieldNaming>AsDeclared</ValidationModules_FieldNaming>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Matrix\Matrix.csproj"/>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
        <!-- MicrosoftExtensionsValidationConfiguration builds a ServiceCollection to get
             ValidationOptions; the Aot probe needs this too, so it is tagged as that library's
             companion. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11">
            <MatrixAotCompanion>Microsoft.Extensions.Validation</MatrixAotCompanion>
        </PackageReference>
        <PackageReference Include="FluentValidation" Version="12.1.1">
            <MatrixLibraryId>FluentValidation</MatrixLibraryId>
            <MatrixLibraryName>FluentValidation</MatrixLibraryName>
            <MatrixCodeName>FluentValidation</MatrixCodeName>
            <MatrixDescription>A strongly typed validation library with fluent rules, nested validators, cascade modes, and asynchronous validation.</MatrixDescription>
            <MatrixDocumentationUrl>https://docs.fluentvalidation.net/</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/FluentValidation/FluentValidation</MatrixRepositoryUrl>
            <MatrixLogo>logos/fluent-validation.svg</MatrixLogo>
        </PackageReference>
        <PackageReference Include="MiniValidation" Version="0.10.0">
            <MatrixLibraryId>MiniValidation</MatrixLibraryId>
            <MatrixLibraryName>MiniValidation</MatrixLibraryName>
            <MatrixCodeName>MiniValidation</MatrixCodeName>
            <MatrixDescription>A minimal DataAnnotations-based validator with recursive object graph traversal and cycle detection.</MatrixDescription>
            <MatrixRepositoryUrl>https://github.com/DamianEdwards/MiniValidation</MatrixRepositoryUrl>
            <MatrixLogo>logos/mini-validation.svg</MatrixLogo>
        </PackageReference>
        <PackageReference Include="ValidationModules.SourceGenerator" Version="1.0.0" PrivateAssets="all">
            <MatrixAotCompanion>ValidationModules</MatrixAotCompanion>
        </PackageReference>
        <PackageReference Include="ValidationModules.Runtime" Version="1.0.0">
            <MatrixLibraryId>ValidationModules</MatrixLibraryId>
            <MatrixLibraryName>ValidationModules</MatrixLibraryName>
            <MatrixCodeName>ValidationModules</MatrixCodeName>
            <MatrixDescription>A build-time validation library whose source generator compiles constraint attributes and rules classes into straight-line validators that use no runtime reflection.</MatrixDescription>
            <MatrixDocumentationUrl>https://ipjohnson.github.io/ValidationModules/</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/ipjohnson/ValidationModules</MatrixRepositoryUrl>
            <MatrixLogo>logos/validation-modules.svg</MatrixLogo>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Validation" Version="10.0.11">
            <MatrixLibraryId>Microsoft.Extensions.Validation</MatrixLibraryId>
            <MatrixLibraryName>Microsoft.Extensions.Validation</MatrixLibraryName>
            <MatrixCodeName>MicrosoftExtensionsValidation</MatrixCodeName>
            <MatrixDescription>The official source-generated validation infrastructure for DataAnnotations-based object graph validation outside ASP.NET Core.</MatrixDescription>
            <MatrixDocumentationUrl>https://learn.microsoft.com/aspnet/core/validation/overview</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/dotnet/dotnet</MatrixRepositoryUrl>
            <MatrixLogo>logos/microsoft-extensions-validation.svg</MatrixLogo>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <MatrixLibrary Include="DataAnnotations">
            <MatrixLibraryName>DataAnnotations</MatrixLibraryName>
            <MatrixCodeName>DataAnnotations</MatrixCodeName>
            <MatrixDescription>The validation attributes and validation APIs included with the .NET framework.</MatrixDescription>
            <MatrixDocumentationUrl>https://learn.microsoft.com/dotnet/api/system.componentmodel.dataannotations</MatrixDocumentationUrl>
            <MatrixLogo>logos/data-annotations.svg</MatrixLogo>
            <MatrixBaseline>true</MatrixBaseline>
            <MatrixRating>true</MatrixRating>
        </MatrixLibrary>
    </ItemGroup>

    <Import Project="..\Matrix\Matrix.Module.targets"/>

</Project>
