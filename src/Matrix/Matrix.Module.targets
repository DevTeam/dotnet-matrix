<Project>

    <ItemGroup>
        <EmbeddedResource Include="$(MSBuildProjectFullPath)"
                          LogicalName="Matrix.Project.csproj"/>
    </ItemGroup>

    <Target Name="GenerateMatrixLibraryCatalog"
            BeforeTargets="CoreCompile">
        <Error Condition="'$(MatrixModuleId)' == ''"
               Text="MatrixModuleId is required."/>
        <Error Condition="'$(MatrixModuleName)' == ''"
               Text="MatrixModuleName is required."/>
        <Error Condition="'$(MatrixRunConfigurationPrefix)' == ''"
               Text="MatrixRunConfigurationPrefix is required."/>
        <Error Condition="'$(MatrixReportDirectory)' == ''"
               Text="MatrixReportDirectory is required."/>
        <Error Condition="'$(MatrixLibraryCatalogNamespace)' == ''"
               Text="MatrixLibraryCatalogNamespace is required."/>

        <PropertyGroup>
            <MatrixLibraryCatalogPath>$(IntermediateOutputPath)Generated\LibraryCatalog.g.cs</MatrixLibraryCatalogPath>
        </PropertyGroup>
        <ItemGroup>
            <_MatrixPackageLibrary Include="@(PackageReference)"
                                   Condition="'%(PackageReference.MatrixLibraryId)' != ''"/>
            <_MatrixSourceLibrary Include="@(MatrixLibrary)">
                <MatrixLibraryId>%(MatrixLibrary.Identity)</MatrixLibraryId>
            </_MatrixSourceLibrary>
            <_MatrixLibrary Include="@(_MatrixPackageLibrary);@(_MatrixSourceLibrary)"/>
        </ItemGroup>

        <Error Condition="'%(_MatrixPackageLibrary.Version)' == ''"
               Text="Matrix library package '%(_MatrixPackageLibrary.Identity)' must define Version."/>
        <Error Condition="'%(_MatrixSourceLibrary.Identity)' != '' and '%(_MatrixSourceLibrary.MatrixBaseline)' != 'true'"
               Text="Package-less matrix library '%(_MatrixSourceLibrary.Identity)' must define MatrixBaseline=true."/>
        <Error Condition="'%(_MatrixLibrary.MatrixLibraryName)' == ''"
               Text="Matrix library '%(_MatrixLibrary.Identity)' must define MatrixLibraryName."/>
        <Error Condition="'%(_MatrixLibrary.MatrixCodeName)' == ''"
               Text="Matrix library '%(_MatrixLibrary.Identity)' must define MatrixCodeName."/>
        <Error Condition="'%(_MatrixLibrary.MatrixDescription)' == ''"
               Text="Matrix library '%(_MatrixLibrary.Identity)' must define MatrixDescription."/>
        <Error Condition="'%(_MatrixPackageLibrary.MatrixDocumentationUrl)' == '' and '%(_MatrixPackageLibrary.MatrixRepositoryUrl)' == ''"
               Text="Matrix library package '%(_MatrixPackageLibrary.Identity)' must define documentation or repository URL."/>
        <Error Condition="'%(_MatrixLibrary.MatrixLogo)' == ''"
               Text="Matrix library '%(_MatrixLibrary.Identity)' must define MatrixLogo."/>

        <ItemGroup>
            <_MatrixLibraryCatalogLine Include="// &lt;auto-generated/&gt;"/>
            <_MatrixLibraryCatalogLine Include="namespace $(MatrixLibraryCatalogNamespace)%3B"/>
            <_MatrixLibraryCatalogLine Include="public static partial class LibraryCatalog"/>
            <_MatrixLibraryCatalogLine Include="{"/>
            <_MatrixLibraryCatalogLine Include="    public const string %(_MatrixLibrary.MatrixCodeName) = &quot;%(_MatrixLibrary.MatrixLibraryId)&quot;%3B"/>
            <_MatrixLibraryCatalogLine Include="}"/>
            <Compile Include="$(MatrixLibraryCatalogPath)"/>
        </ItemGroup>
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MatrixLibraryCatalogPath)'))"/>
        <WriteLinesToFile File="$(MatrixLibraryCatalogPath)"
                          Lines="@(_MatrixLibraryCatalogLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"/>
    </Target>

</Project>
