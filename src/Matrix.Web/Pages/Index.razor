@page "/"
@inject IMatrixDataSource DataSource
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IMatrixView View
@inject IMatrixScoring Scoring

<PageTitle>.NET Matrix — compare .NET libraries</PageTitle>

<div class="app-shell">
    @* aria-modal alone only tells a screen reader the background is gone; inert is
       what actually takes it out of the tab order and out of the accessibility tree.
       Nothing about it is visible. *@
    <header class="topbar" inert="@IsDialogOpen">
        <a class="brand" href="./" aria-label=".NET Matrix home">
            <img class="brand-mark" src="icon.svg" alt="" aria-hidden="true"/>
            <span>
                <strong>.NET Matrix</strong>
                <small>Library intelligence</small>
            </span>
        </a>

        <div class="topbar-end">
        @if (_catalog is not null)
        {
            <div class="release-picker">
                <label for="release">Release</label>
                <select id="release" value="@_selectedVersion" @onchange="ChangeVersion">
                    @foreach (var version in _catalog.Versions)
                    {
                        <option value="@version.Version">
                            @VersionLabel(version)
                        </option>
                    }
                </select>
                @if (SelectedVersion is { Released: true, Commit.Length: > 0 })
                {
                    <a class="commit-link"
                       href="@CommitUrl(SelectedVersion)"
                       target="_blank"
                       rel="noreferrer"
                       title="Open commit on GitHub">
                        @ShortCommit(SelectedVersion.Commit) ↗
                    </a>
                }
                else if (SelectedVersion is { Released: false, Commit.Length: > 0 })
                {
                    <span class="release-chip"
                          title="Reports are read from the branch and change with every merge">
                        unreleased
                    </span>
                }
            </div>
        }
            <div class="topbar-links">
                <a class="icon-link"
                   href="@RepositoryUrl"
                   target="_blank"
                   rel="noreferrer"
                   title="Project repository on GitHub"
                   aria-label="Project repository on GitHub">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
                    </svg>
                </a>
                <a class="icon-link"
                   href="@AuthorUrl"
                   target="_blank"
                   rel="noreferrer"
                   title="Author: Nikolay Pianikov"
                   aria-label="Author on GitHub: Nikolay Pianikov">
                    <svg viewBox="0 0 16 16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6"
                         stroke-linecap="round"
                         aria-hidden="true"
                         focusable="false">
                        <circle cx="8" cy="5.2" r="2.7"/>
                        <path d="M2.9 13.6c.6-2.5 2.6-3.9 5.1-3.9s4.5 1.4 5.1 3.9"/>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    @if (_loadingCatalog)
    {
        <main class="center-state">
            <span class="loader"></span>
            <p>Loading release catalog…</p>
        </main>
    }
    else if (_fatalError is not null)
    {
        <main class="center-state error-state">
            <span class="state-icon">!</span>
            <h1>Unable to load .NET Matrix</h1>
            <p>@_fatalError</p>
        </main>
    }
    else if (_catalog is not null && _catalog.Versions.Count == 0)
    {
        <main class="center-state">
            <span class="state-icon">∅</span>
            <h1>@(_catalogWarning is null ? "No releases yet" : "Unable to list releases")</h1>
            <p>
                @(_catalogWarning
                  ?? "Create a Git tag in the 1.0.0 format and reload the page.")
            </p>
        </main>
    }
    else
    {
        <div class="workspace" inert="@IsDialogOpen">
            @* Below the sidebar breakpoint the panel folds behind this control, so a
               phone opens on the data instead of on a screen and a half of filters.
               A checkbox holds the state because the application ships no script of
               its own; the wide layout switches the whole mechanism off in CSS. *@
            <input class="filters-toggle"
                   type="checkbox"
                   id="filters-toggle"
                   aria-label="Show the comparison filters"/>
            <label class="filters-summary" for="filters-toggle">
                <span>
                    <strong>@SelectedCategoryName</strong>
                    <small>@SelectedShownCount of @ShownLibraryCount libraries</small>
                </span>
                <span class="filters-summary-action" aria-hidden="true">
                    <svg viewBox="0 0 16 16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         focusable="false">
                        <path d="M2.5 4.5h11M4.5 8h7M6.5 11.5h3"/>
                    </svg>
                    Filter
                </span>
            </label>

            <aside class="filters">
                <div class="filters-heading">
                    <div>
                        <p class="eyebrow">Scope</p>
                        <h2>Compare</h2>
                    </div>
                </div>

                <section class="filter-section">
                    <h3>Categories</h3>
                    @foreach (var category in _catalog!.Categories)
                    {
                        <label class="check-row">
                            <input type="radio"
                                   name="category"
                                   value="@category.Id"
                                   checked="@category.Id.Equals(
                                                _selectedCategoryId,
                                                StringComparison.OrdinalIgnoreCase)"
                                   @onchange="() => SelectCategory(category.Id)"/>
                            <span>@category.Name</span>
                        </label>
                    }
                </section>

                <section class="filter-section">
                    <div class="filter-section-head">
                        <SelectAllToggle Selected="@SelectedShownCount"
                                         Total="@ShownLibraryCount"
                                         OnToggle="ToggleShownLibraries"/>
                        <h3>Libraries</h3>
                        <span class="filter-count">
                            @SelectedShownCount / @ShownLibraryCount
                        </span>
                    </div>
                    <input class="filter-search"
                           type="search"
                           placeholder="Filter by name"
                           aria-label="Filter libraries by name"
                           @bind="_librarySearch"
                           @bind:event="oninput"
                           @onkeydown="ClearSearchOnEscape"/>
                    @if (ShownLibraryCount == 0)
                    {
                        <p class="muted">Nothing matches “@_librarySearch”.</p>
                    }
                    @foreach (var report in VisibleReports)
                    {
                        var libraries = Libraries(report).Where(Matches).ToArray();
                        if (libraries.Length == 0)
                        {
                            continue;
                        }

                        var medals = Scoring.Rating(report, _selectedLibraries);
                        <div class="library-group">
                            <div class="group-label">@report.Category.Name</div>
                            @foreach (var library in libraries)
                            {
                                var key = LibraryKey(report.Category.Id, library.Id);
                                @* The label wraps only the checkbox, so the details
                                   button beside it does not toggle the selection. *@
                                <div class="library-row">
                                    <label class="check-row">
                                        <input type="checkbox"
                                               checked="@_selectedLibraries.Contains(key)"
                                               @onchange="eventArgs => ToggleLibrary(key, eventArgs)"/>
                                        <LibraryLogo Source="@View.Logo(report, library.Id)"
                                                     Name="@library.Name"
                                                     Size="xs"/>
                                        <span>
                                            @library.Name
                                            <small>@library.Version</small>
                                        </span>
                                    </label>
                                    <RatingBadge Category="@report.Category.Name"
                                                 Rated="@View.IsRated(report, library.Id)"
                                                 Standing="@Scoring.Standing(medals, library.Id)"
                                                 Place="@Scoring.Place(medals, library.Id)"/>
                                    <button class="library-info"
                                            type="button"
                                            title="@($"Open the {library.Name} overview")"
                                            aria-label="@($"Open the {library.Name} overview")"
                                            @onclick="() => OpenLibrary(library.Id)">
                                        <svg viewBox="0 0 16 16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6"
                                             stroke-linecap="round"
                                             aria-hidden="true"
                                             focusable="false">
                                            <circle cx="8" cy="8" r="6.3"/>
                                            <path d="M8 7.2v4"/>
                                            <path d="M8 4.7v.1"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </section>

            </aside>

            <main class="content">
                <section class="hero">
                    <div>
                        <p class="eyebrow">Evidence, not faith</p>
                        <h1>Choose with confidence.</h1>
                        <p class="hero-copy">
                            Compare capabilities, execution time and allocations across .NET libraries
                            from reproducible reports.
                        </p>
                    </div>
                </section>

                <nav class="tabs" aria-label="Report views">
                    @foreach (var view in Views)
                    {
                        <button class="@TabClass(view.Id)" @onclick="() => _view = view.Id">
                            @view.Name
                        </button>
                    }
                    <div class="tabs-summary" aria-label="Report summary">
                        <span><strong>@SelectedLibraryCount</strong> libraries</span>
                        <span><strong>@FeatureCount</strong> scenarios</span>
                    </div>
                </nav>

                @if (_loadingReports)
                {
                    <section class="panel loading-panel">
                        <span class="loader"></span>
                        <p>Loading reports from GitHub…</p>
                    </section>
                }
                else if (_selectedCategoryId is null)
                {
                    <EmptyState Title="Select a category"
                                Text="Choose a library category in the filter panel."/>
                }
                else
                {
                    @if (_catalogWarning is not null)
                    {
                        <div class="notice warning">
                            <strong>Releases:</strong> @_catalogWarning
                        </div>
                    }

                    @foreach (var report in VisibleReports.Where(report => report.Error is not null))
                    {
                        <div class="notice warning">
                            <strong>@report.Category.Name:</strong> @report.Error
                            @* ReSharper disable once UseCollectionExpression *@
                        </div>
                    }

                    @* Every view draws from the selection, so an empty one leaves a
                       blank page. Said once here rather than in each view. *@
                    @if (SelectedLibraryCount == 0 && _view != "environment" && _view != "evidence")
                    {
                        <EmptyState Title="No libraries selected"
                                    Text="Pick at least one library in the filter panel to compare."/>
                    }
                    else
                    {
                    @switch (_view)
                    {
                        case "features":
                            <FeaturesView Reports="@VisibleReports.ToArray()"
                                          SelectedLibraries="@_selectedLibraries"
                                          OnOpenLibrary="@OpenLibrary"/>
                            break;
                        case "benchmarks":
                            <BenchmarksView Reports="@VisibleReports.ToArray()"
                                            SelectedLibraries="@_selectedLibraries"
                                            OnOpenLibrary="@OpenLibrary"
                                            OnHelp="@OpenHelp"/>
                            break;
                        case "environment":
                            <EnvironmentView Reports="@VisibleReports.ToArray()"/>
                            break;
                        case "evidence":
                            <EvidenceView Reports="@VisibleReports.ToArray()"
                                          Repository="@_catalog!.Repository"
                                          ReportReference="@SelectedVersion?.Commit"/>
                            break;
                        default:
                            <OverviewView Reports="@VisibleReports.ToArray()"
                                          SelectedLibraries="@_selectedLibraries"
                                          OnOpenLibrary="@OpenLibrary"
                                          OnHelp="@OpenHelp"
                                          LibraryLink="@LibraryLink"/>
                            break;
                    }
                    }
                }
            </main>
        </div>

        @if (OpenReport is { } openReport && OpenLibraryValue is { } openLibrary)
        {
            <LibraryDialog Report="@openReport"
                           Library="@openLibrary"
                           SelectedLibraries="@_selectedLibraries"
                           Link="@LibraryLink(openLibrary.Id)"
                           OnOpenLibrary="@OpenLibrary"
                           OnClose="CloseLibrary"/>
        }

        @if (_help is { } help)
        {
            <HelpDialog Topic="@help" OnClose="CloseHelp"/>
        }
    }
</div>

@code {
    private static readonly (string Id, string Name)[] Views =
    [
        ("overview", "Overview"),
        ("features", "Features"),
        ("benchmarks", "Benchmarks"),
        ("environment", "Environment"),
        ("evidence", "Evidence")
    ];

    private const string CategoryParameter = "category";
    private const string LibraryParameter = "library";
    private const string LibrariesParameter = "libraries";
    private const string VersionParameter = "version";
    private const string LatestVersion = "latest";

    /// <summary>
    /// Written when the comparison is empty, because an absent parameter already
    /// means the whole category and the two states have to stay distinguishable.
    /// </summary>
    private const string NoLibraries = "none";

    /// <summary>
    /// Marks <c>?libraries=</c> as a list of what to leave out rather than what to
    /// keep, as in <c>?libraries=-MvvmCross,Catel</c>.
    /// </summary>
    private const string Without = "-";

    /// <summary>
    /// A link published elsewhere can name the category to open, as in
    /// <c>?category=dependency-injection</c>. The query string is used rather than a
    /// route because GitHub Pages serves only the root document of this application.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = CategoryParameter)]
    public string? Category { get; set; }

    /// <summary>
    /// Opens the overview of one library, as in <c>?library=sep</c>. The category is
    /// found from the library, so a page about a library needs only this one value.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = LibraryParameter)]
    public string? Library { get; set; }

    /// <summary>
    /// Narrows the comparison, as in <c>?libraries=Pure.DI,DryIoc,Grace</c>, or names
    /// what to leave out, as in <c>?libraries=-MvvmCross,Catel</c>. This belongs in
    /// the address because it belongs in the result: points are measured against the
    /// best of the compared libraries, so a link that dropped the selection would
    /// show different numbers under the same names. Absent means the whole category,
    /// which is why the default view carries no parameter.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = LibrariesParameter)]
    public string? ComparedLibraries { get; set; }

    /// <summary>
    /// Pins the reports to one release, as in <c>?version=1.4.0</c>. Absent, or
    /// <c>latest</c>, means the newest entry of the catalog.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = VersionParameter)]
    public string? Version { get; set; }

    private MatrixWebCatalog? _catalog;
    private string? _openLibraryId;
    private IReadOnlyList<CategoryReport> _reports = [];
    private string? _selectedCategoryId;
    private readonly HashSet<string> _selectedLibraries = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedVersion;
    private string _view = "overview";
    private bool _loadingCatalog = true;
    private bool _loadingReports;
    private string? _fatalError;
    private string? _catalogWarning;
    private string _librarySearch = string.Empty;

    private MatrixVersion? SelectedVersion =>
        _catalog?.Versions.FirstOrDefault(version => version.Version == _selectedVersion);

    private IEnumerable<CategoryReport> VisibleReports =>
        _reports.Where(report => report.Category.Id.Equals(
            _selectedCategoryId,
            StringComparison.OrdinalIgnoreCase));

    private int SelectedLibraryCount => VisibleReports
        .SelectMany(Libraries)
        .Count(library => _selectedLibraries.Contains(
            LibraryKey(_selectedCategoryId!, library.Id)));

    /// <summary>
    /// The rows the name filter currently leaves visible. Bulk selection works on
    /// this set, so narrowing the list and taking everything shown is one move.
    /// </summary>
    private IEnumerable<string> ShownLibraryKeys => VisibleReports
        .SelectMany(report => Libraries(report)
            .Where(Matches)
            .Select(library => LibraryKey(report.Category.Id, library.Id)));

    private int ShownLibraryCount => ShownLibraryKeys.Count();

    private int SelectedShownCount => ShownLibraryKeys.Count(_selectedLibraries.Contains);

    private string SelectedCategoryName => _catalog?.Categories
        .FirstOrDefault(category => category.Id.Equals(
            _selectedCategoryId,
            StringComparison.OrdinalIgnoreCase))
        ?.Name ?? "No category";

    private bool Matches(MatrixLibrary library) =>
        _librarySearch.Length == 0
        || library.Name.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase)
        // Reports may omit the package, the hand-coded baseline has none.
        || library.Package?.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase) == true;

    private void ToggleShownLibraries()
    {
        var keys = ShownLibraryKeys.ToArray();
        if (keys.Length > 0 && keys.All(_selectedLibraries.Contains))
        {
            _selectedLibraries.ExceptWith(keys);
        }
        else
        {
            _selectedLibraries.UnionWith(keys);
        }

        RememberComparedLibraries();
    }

    private void ClearSearchOnEscape(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            _librarySearch = string.Empty;
        }
    }

    private int FeatureCount => VisibleReports
        .SelectMany(report => report.Features?.Features ?? [])
        .Select(feature => $"{feature.Order}:{feature.Id}")
        .Distinct(StringComparer.Ordinal)
        .Count();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await DataSource.LoadCatalogAsync();
            _catalog = result.Catalog;
            _catalogWarning = result.Warning;
            _selectedCategoryId =
                ResolveCategory(Category) ?? _catalog.Categories.FirstOrDefault()?.Id;

            _selectedVersion = ResolveVersion(Version) ?? LatestVersionId;
            if (SelectedVersion is not null)
            {
                await LoadReportsAsync();
            }
        }
        catch (Exception exception)
        {
            _fatalError = exception.Message;
        }
        finally
        {
            _loadingCatalog = false;
        }
    }

    /// <summary>
    /// The picker only writes the address; loading is driven from there, so the
    /// selection has one source whether it came from a link or from this control.
    /// </summary>
    private void ChangeVersion(ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value?.ToString() is { Length: > 0 } version)
        {
            Navigation.NavigateTo(VersionLink(version), replace: true);
        }
    }

    private string? LatestVersionId => _catalog?.Versions.FirstOrDefault()?.Version;

    /// <summary>
    /// Unlike a category, a version is matched exactly: dropping the punctuation of
    /// 1.2.3 would make it indistinguishable from 12.3.
    /// </summary>
    private string? ResolveVersion(string? value)
    {
        if (_catalog is null || string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var wanted = value.Trim();
        return wanted.Equals(LatestVersion, StringComparison.OrdinalIgnoreCase)
            ? LatestVersionId
            : _catalog.Versions
                .FirstOrDefault(version =>
                    version.Version.Equals(wanted, StringComparison.OrdinalIgnoreCase))
                ?.Version;
    }

    /// <summary>
    /// The newest release is left out of the address, so a link shared from the
    /// default view keeps following new releases instead of freezing on today's.
    /// </summary>
    private bool IsLatest(string? version) =>
        version is null || version == LatestVersionId;

    /// <summary>
    /// A release change reloads every report and reselects everything, so the
    /// comparison of the previous release is dropped rather than carried over.
    /// </summary>
    private string VersionLink(string version) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [VersionParameter] = IsLatest(version) ? null : version,
            [LibrariesParameter] = null
        });

    private void SelectCategory(string categoryId)
    {
        _selectedCategoryId = categoryId;
        _openLibraryId = null;
        // The address bar stays a link worth copying. Replacing the entry keeps the
        // back button pointing at wherever the visitor came from.
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                [CategoryParameter] = categoryId,
                // The library and the comparison of the previous category have no
                // meaning here, and a stale set would silently narrow the new one.
                [LibraryParameter] = null,
                [LibrariesParameter] = null
            }),
            replace: true);
    }

    /// <summary>
    /// An unknown category falls back to the default one: a typo in a link published
    /// on another site is nothing the visitor reading it can fix.
    /// </summary>
    private string? ResolveCategory(string? value)
    {
        if (_catalog is null || string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var wanted = Simplify(value);
        return _catalog.Categories
            .FirstOrDefault(category =>
                Simplify(category.Id) == wanted || Simplify(category.Name) == wanted)
            ?.Id;
    }

    /// <summary>
    /// The dialog follows the address rather than a field of its own. Opening pushes
    /// a history entry, so the back button closes the dialog for a visitor who
    /// opened it here, and leaves the site for one who arrived on the link.
    /// </summary>
    /// <remarks>
    /// The comparison is named explicitly here and in the two below. The address is
    /// written outside the router, so what Blazor believes the current address to be
    /// can lag behind it; stating the value rather than inheriting it is what keeps
    /// a navigation from dropping a selection.
    /// </remarks>
    private void OpenLibrary(string libraryId) =>
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                [LibrariesParameter] = ComparedLibrariesValue,
                [LibraryParameter] = libraryId
            }));

    /// <summary>
    /// Closing leaves the category behind, so the address stays a link to what is on
    /// screen even for a visitor who arrived on a bare <c>?library=…</c>.
    /// </summary>
    private void CloseLibrary() =>
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                [CategoryParameter] = _selectedCategoryId,
                [LibrariesParameter] = ComparedLibrariesValue,
                [LibraryParameter] = null
            }),
            replace: true);

    private string LibraryLink(string libraryId) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [VersionParameter] = IsLatest(_selectedVersion) ? null : _selectedVersion,
            [CategoryParameter] = _selectedCategoryId,
            [LibrariesParameter] = ComparedLibrariesValue,
            [LibraryParameter] = libraryId
        });

    /// <summary>
    /// Which explanation is open, if any. Kept out of the address: it is a
    /// reading aid, not a state worth sharing.
    /// </summary>
    private string? _help;

    private bool IsDialogOpen => IsLibraryOpen || _help is not null;

    private bool IsLibraryOpen => OpenLibraryValue is not null;

    private void OpenHelp(string topic) => _help = topic;

    private void CloseHelp() => _help = null;

    private CategoryReport? OpenReport => _openLibraryId is null
        ? null
        : VisibleReports.FirstOrDefault();

    private MatrixLibrary? OpenLibraryValue => OpenReport is { } report
        ? Libraries(report).FirstOrDefault(library =>
            library.Id.Equals(_openLibraryId, StringComparison.OrdinalIgnoreCase))
        : null;

    /// <summary>
    /// The library is looked up in every loaded category, the selected one first, so
    /// <c>?library=…</c> alone is enough and <c>?category=…</c> only breaks a tie.
    /// Package names are matched too: a page about a library knows its package id
    /// long before it knows the id used here.
    /// </summary>
    private (string CategoryId, string LibraryId)? FindLibrary(string value)
    {
        var wanted = Simplify(value);
        var reports = _reports
            .OrderByDescending(report => report.Category.Id.Equals(
                _selectedCategoryId,
                StringComparison.OrdinalIgnoreCase));
        foreach (var report in reports)
        {
            foreach (var library in Libraries(report))
            {
                if (Simplify(library.Id) == wanted
                    || Simplify(library.Name) == wanted
                    || (library.Package is { Length: > 0 } package && Simplify(package) == wanted))
                {
                    return (report.Category.Id, library.Id);
                }
            }
        }

        return null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_catalog is null)
        {
            return;
        }

        // Before anything else: the reports of the other views are read from here.
        var version = ResolveVersion(Version) ?? LatestVersionId;
        if (version is not null && version != _selectedVersion)
        {
            _selectedVersion = version;
            _selectedLibraries.Clear();
            await LoadReportsAsync();
        }

        if (ResolveCategory(Category) is { } categoryId)
        {
            _selectedCategoryId = categoryId;
        }

        ApplyComparedLibraries();

        if (string.IsNullOrWhiteSpace(Library))
        {
            _openLibraryId = null;
            return;
        }

        if (FindLibrary(Library) is not { } found)
        {
            _openLibraryId = null;
            return;
        }

        _selectedCategoryId = found.CategoryId;
        _openLibraryId = found.LibraryId;
    }

    /// <summary>
    /// dependency-injection, DependencyInjection and "Dependency Injection" all name
    /// the same category: a hand-written link should not have to match the id exactly.
    /// </summary>
    private static string Simplify(string value) =>
        string.Concat(value.Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private void ToggleLibrary(string key, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _selectedLibraries.Add(key);
        }
        else
        {
            _selectedLibraries.Remove(key);
        }

        RememberComparedLibraries();
    }

    private void SelectAllLibraries()
    {
        foreach (var report in VisibleReports)
        {
            foreach (var library in Libraries(report))
            {
                _selectedLibraries.Add(LibraryKey(report.Category.Id, library.Id));
            }
        }

        RememberComparedLibraries();
    }

    /// <summary>
    /// Reads <c>?libraries=</c> into the selection of the category on screen. Names,
    /// ids and package names all match, and an unknown name is simply not selected:
    /// a link edited by hand should behave, not fail.
    /// </summary>
    private void ApplyComparedLibraries()
    {
        // The address already describes what is selected, so there is nothing to
        // read back. This is also what keeps a navigation from undoing a selection
        // whose address was written straight to the history entry.
        if (string.Equals(ComparedLibraries, ComparedLibrariesValue, StringComparison.Ordinal))
        {
            return;
        }

        if (_selectedCategoryId is not { } categoryId
            || _reports.FirstOrDefault(report => report.Category.Id.Equals(
                categoryId,
                StringComparison.OrdinalIgnoreCase)) is not { } report)
        {
            return;
        }

        var libraries = Libraries(report).ToArray();
        if (string.IsNullOrWhiteSpace(ComparedLibraries))
        {
            foreach (var library in libraries)
            {
                _selectedLibraries.Add(LibraryKey(categoryId, library.Id));
            }

            return;
        }

        var excluding = ComparedLibraries.StartsWith(Without, StringComparison.Ordinal);
        var named = ComparedLibraries[(excluding ? Without.Length : 0)..]
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(Simplify)
            .ToHashSet(StringComparer.Ordinal);
        foreach (var library in libraries)
        {
            var key = LibraryKey(categoryId, library.Id);
            if (Names(library).Any(named.Contains) != excluding)
            {
                _selectedLibraries.Add(key);
            }
            else
            {
                _selectedLibraries.Remove(key);
            }
        }
    }

    /// <summary>
    /// Everything a link may call this library by. A page about a library knows its
    /// package name long before it knows the id used here.
    /// </summary>
    private static IEnumerable<string> Names(MatrixLibrary library)
    {
        yield return Simplify(library.Id);
        yield return Simplify(library.Name);
        if (library.Package is { Length: > 0 } package)
        {
            yield return Simplify(package);
        }
    }

    /// <summary>
    /// The address follows the selection, but this is not navigation: the selection
    /// is already applied and the address bar is catching up with it. Going through
    /// <c>NavigateTo</c> makes the router set the parameters again and render the
    /// whole workspace a second time — measured at 825 ms against 1 650 ms for
    /// selecting all twenty-three libraries. Writing the entry directly costs one
    /// interop call and no render. History behaves the same as <c>replace: true</c>:
    /// no entry is added, so the back button still points at wherever the visitor
    /// came from rather than at every checkbox they touched.
    /// </summary>
    private async Task RememberComparedLibrariesAsync()
    {
        var value = ComparedLibrariesValue;
        var address = Navigation.GetUriWithQueryParameter(LibrariesParameter, value);
        // The router is bypassed, so nothing else will refresh the parameter; kept
        // in step here, the next real navigation sees no change and leaves the
        // selection alone.
        ComparedLibraries = value;
        try
        {
            await JsRuntime.InvokeVoidAsync("history.replaceState", null, string.Empty, address);
        }
        catch (JSException)
        {
            // A browser that refuses the call leaves the address behind; the
            // comparison on screen is still correct, and the links built for
            // copying carry the selection of their own accord.
        }
    }

    /// <summary>
    /// Fire and forget: the selection is already applied, and the address is a
    /// side effect the visitor should never wait for.
    /// </summary>
    private void RememberComparedLibraries() => _ = RememberComparedLibrariesAsync();

    /// <summary>
    /// Only the category on screen, and only when the set is not everything: the
    /// default view keeps a clean address.
    /// </summary>
    private string? ComparedLibrariesValue
    {
        get
        {
            if (_selectedCategoryId is not { } categoryId
                || _reports.FirstOrDefault(report => report.Category.Id.Equals(
                    categoryId,
                    StringComparison.OrdinalIgnoreCase)) is not { } report)
            {
                return null;
            }

            var libraries = Libraries(report).ToArray();
            var chosen = libraries
                .Where(library => _selectedLibraries.Contains(LibraryKey(categoryId, library.Id)))
                .Select(library => library.Id)
                .ToArray();
            if (chosen.Length == libraries.Length)
            {
                return null;
            }

            if (chosen.Length == 0)
            {
                return NoLibraries;
            }

            // Dropping two of twenty-two is the common gesture, and naming the twenty
            // would make an address nobody wants to paste. Whichever list is shorter
            // wins, and the leading dash says which one it is.
            var dropped = libraries.Length - chosen.Length;
            return dropped < chosen.Length
                ? Without + string.Join(
                    ',',
                    libraries
                        .Where(library =>
                            !_selectedLibraries.Contains(LibraryKey(categoryId, library.Id)))
                        .Select(library => library.Id))
                : string.Join(',', chosen);
        }
    }

    private async Task LoadReportsAsync()
    {
        if (_catalog is null || SelectedVersion is null)
        {
            return;
        }

        _loadingReports = true;
        try
        {
            _reports = await DataSource.LoadAsync(
                _catalog,
                SelectedVersion,
                _catalog.Categories);
            SelectAllLibrariesInEveryCategory();
        }
        finally
        {
            _loadingReports = false;
        }

        await LoadVersionDateAsync();
    }

    /// <summary>
    /// Dates are fetched one version at a time, only for the version being viewed.
    /// </summary>
    private async Task LoadVersionDateAsync()
    {
        if (_catalog is null || SelectedVersion is not { DateUtc: null } version)
        {
            return;
        }

        var date = await DataSource.LoadVersionDateAsync(_catalog, version);
        if (date is null)
        {
            return;
        }

        _catalog = _catalog with
        {
            Versions = [.. _catalog.Versions.Select(item =>
                item.Version == version.Version ? item with { DateUtc = date } : item)]
        };
        StateHasChanged();
    }

    private IEnumerable<MatrixLibrary> Libraries(CategoryReport report) =>
        View.Libraries(report);

    private void SelectAllLibrariesInEveryCategory()
    {
        foreach (var report in _reports)
        {
            foreach (var library in Libraries(report))
            {
                _selectedLibraries.Add(LibraryKey(report.Category.Id, library.Id));
            }
        }
    }
    
    private static string LibraryKey(string categoryId, string libraryId) =>
        $"{categoryId}\u001f{libraryId}";

    private string TabClass(string view) => view == _view ? "tab active" : "tab";

    private const string AuthorUrl = "https://github.com/NikolayPianikov";

    /// <summary>
    /// Taken from the catalog so the repository is named in one place; the literal
    /// keeps the link alive on the error screen, where the catalog may be missing.
    /// </summary>
    private string RepositoryUrl => _catalog is { } catalog
        ? $"https://github.com/{catalog.Repository.Owner}/{catalog.Repository.Name}"
        : "https://github.com/DevTeam/dotnet-matrix";

    private string CommitUrl(MatrixVersion version) =>
        $"https://github.com/{_catalog!.Repository.Owner}/{_catalog.Repository.Name}/commit/{version.Commit}";

    private static string ShortCommit(string commit) =>
        commit[..Math.Min(7, commit.Length)];

    /// <summary>
    /// Every label reads as name · qualifier and stays about as long as the others,
    /// so the picker is one steady box rather than one that resizes on each choice.
    /// </summary>
    private static string VersionLabel(MatrixVersion version) =>
        version switch
        {
            { Version: "local" } => "Local · workspace",
            { Released: false } => $"{version.Version} · latest",
            { DateUtc: { } date } => $"{version.Version} · {date:dd MMM yyyy}",
            _ => version.Version
        };

}
