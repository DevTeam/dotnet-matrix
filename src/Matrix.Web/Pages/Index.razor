@page "/"
@inject IMatrixDataSource DataSource
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IMatrixView View
@inject IMatrixScoring Scoring

<PageTitle>.NET Matrix — compare .NET libraries</PageTitle>

<div class="app-shell">
    @* aria-modal alone only tells a screen reader the background is gone; inert is
       what actually takes it out of the tab order and out of the accessibility tree.
       Nothing about it is visible. *@
    <header class="topbar" inert="@IsDialogOpen">
        <div class="topbar-default">
        <a class="brand" href="./" aria-label=".NET Matrix home">
            <img class="brand-mark" src="icon.svg" alt="" aria-hidden="true"/>
            <span>
                <strong>.NET Matrix</strong>
                <small>Library intelligence</small>
            </span>
        </a>

        <div class="topbar-end">
        @if (_catalog is not null)
        {
            <div class="release-picker">
                <label for="release">Release</label>
                <select id="release" value="@_selectedVersion" @onchange="ChangeVersion">
                    @foreach (var version in _catalog.Versions)
                    {
                        <option value="@version.Version">
                            @VersionLabel(version)
                        </option>
                    }
                </select>
                @if (SelectedVersion is { Released: true, Commit.Length: > 0 })
                {
                    <a class="commit-link"
                       href="@CommitUrl(SelectedVersion)"
                       target="_blank"
                       rel="noreferrer"
                       title="Open commit on GitHub">
                        @ShortCommit(SelectedVersion.Commit) ↗
                    </a>
                }
            </div>
        }
            <div class="topbar-links">
                <a class="icon-link"
                   href="@RepositoryUrl"
                   target="_blank"
                   rel="noreferrer"
                   title="Project repository on GitHub"
                   aria-label="Project repository on GitHub">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
                    </svg>
                </a>
                <a class="icon-link"
                   href="@AuthorUrl"
                   target="_blank"
                   rel="noreferrer"
                   title="Author: Nikolay Pianikov"
                   aria-label="Author on GitHub: Nikolay Pianikov">
                    <svg viewBox="0 0 16 16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6"
                         stroke-linecap="round"
                         aria-hidden="true"
                         focusable="false">
                        <circle cx="8" cy="5.2" r="2.7"/>
                        <path d="M2.9 13.6c.6-2.5 2.6-3.9 5.1-3.9s4.5 1.4 5.1 3.9"/>
                    </svg>
                </a>
            </div>
        </div>
        </div>

        <div class="topbar-context" aria-label="Current comparison">
            <div class="context-category">
                <span>Category</span>
                <strong>@SelectedCategoryName</strong>
            </div>
            @if (HasFeatureFilter)
            {
                <details class="context-selection">
                    <summary title="@SelectedFeatureNames">
                        <span>Scenarios</span>
                        <strong>@FeatureSelectionSummary</strong>
                    </summary>
                    <div class="context-selection-menu">
                        <strong>Selected scenarios</strong>
                        <small>@SelectedFeatureCount of @CategoryFeatureCount</small>
                        @if (SelectedFeatureNameItems.Count == 0)
                        {
                            <p>None selected.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var name in SelectedFeatureNameItems)
                                {
                                    <li>@name</li>
                                }
                            </ul>
                        }
                    </div>
                </details>
            }
            @if (HasLibraryFilter)
            {
                <details class="context-selection">
                    <summary title="@SelectedLibraryNames">
                        <span>Libraries</span>
                        <strong>@LibrarySelectionSummary</strong>
                    </summary>
                    <div class="context-selection-menu">
                        <strong>Selected libraries</strong>
                        <small>@SelectedLibraryCount of @CategoryLibraryCount</small>
                        @if (SelectedLibraryNameItems.Count == 0)
                        {
                            <p>None selected.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var name in SelectedLibraryNameItems)
                                {
                                    <li>@name</li>
                                }
                            </ul>
                        }
                    </div>
                </details>
            }
        </div>
    </header>

    @if (_loadingCatalog)
    {
        <main class="center-state">
            <span class="loader"></span>
            <p>Loading release catalog…</p>
        </main>
    }
    else if (_fatalError is not null)
    {
        <main class="center-state error-state">
            <span class="state-icon">!</span>
            <h1>Unable to load .NET Matrix</h1>
            <p>@_fatalError</p>
        </main>
    }
    else if (_catalog is not null && _catalog.Versions.Count == 0)
    {
        <main class="center-state">
            <span class="state-icon">∅</span>
            <h1>@(_catalogWarning is null ? "No releases yet" : "Unable to list releases")</h1>
            <p>
                @(_catalogWarning
                  ?? "Create a Git tag in the 1.0.0 format and reload the page.")
            </p>
        </main>
    }
    else
    {
        <div class="workspace" inert="@IsDialogOpen">
            <div class="sidebar">
            @* Below the sidebar breakpoint the panel folds behind this control, so a
               phone opens on the data instead of on a screen and a half of filters.
               A checkbox holds the state because the application ships no script of
               its own; the wide layout switches the whole mechanism off in CSS. *@
            <input class="filters-toggle"
                   type="checkbox"
                   id="filters-toggle"
                   aria-label="Show the comparison filters"/>

            <div class="filters-heading">
                <div>
                    <p class="eyebrow">Scope</p>
                    <h2>Compare</h2>
                </div>
            </div>

            @* Outside the folded panel: the category is the first thing chosen and
               the last thing worth hiding, so on a phone it stays above the Filter
               control rather than behind it. The rows flow into as many columns as
               the width allows, so a category added or removed needs no layout
               change here. *@
            <nav class="categories" aria-label="Library categories">
                <section class="filter-section">
                    <h3>Categories</h3>
                    @foreach (var category in _catalog!.Categories)
                    {
                        <label class="check-row">
                            <input type="radio"
                                   name="category"
                                   value="@category.Id"
                                   checked="@category.Id.Equals(
                                                _selectedCategoryId,
                                                StringComparison.OrdinalIgnoreCase)"
                                   @onchange="() => SelectCategory(category.Id)"/>
                            <span>@category.Name</span>
                        </label>
                    }
                </section>
            </nav>

            <label class="filters-summary" for="filters-toggle">
                <span>
                    <strong>@SelectedCategoryName</strong>
                    <small>
                        @SelectedShownFeatureCount of @ShownFeatureCount scenarios ·
                        @SelectedShownCount of @ShownLibraryCount libraries
                    </small>
                </span>
                <span class="filters-summary-action" aria-hidden="true">
                    <svg viewBox="0 0 16 16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         focusable="false">
                        <path d="M2.5 4.5h11M4.5 8h7M6.5 11.5h3"/>
                    </svg>
                    Filter
                </span>
            </label>

            <aside class="filters">
                @* Before the libraries, because it narrows what they are compared
                   on: points are measured over the chosen scenarios, so the two
                   selections are read in the order they apply. *@
                <section class="filter-section">
                    <div class="filter-section-head">
                        <SelectAllToggle Selected="@SelectedShownFeatureCount"
                                         Total="@ShownFeatureCount"
                                         OnToggle="ToggleShownFeatures"/>
                        <h3>Scenarios</h3>
                        <span class="filter-count">
                            @SelectedShownFeatureCount / @ShownFeatureCount
                            @if (ShownNotRatedFeatureCount > 0)
                            {
                                <text> · </text><span class="filter-count-note">@ShownNotRatedFeatureCount not rated</span>
                            }
                        </span>
                    </div>
                    <input class="filter-search"
                           type="search"
                           placeholder="Filter by name"
                           aria-label="Filter scenarios by name"
                           @bind="_featureSearch"
                           @bind:event="oninput"
                           @onkeydown="ClearFeatureSearchOnEscape"/>
                    @if (ShownFeatureCount == 0)
                    {
                        <p class="muted">Nothing matches “@_featureSearch”.</p>
                    }
                    @foreach (var report in VisibleReports)
                    {
                        var features = View.Features(report).Where(MatchesFeature).ToArray();
                        if (features.Length == 0)
                        {
                            continue;
                        }

                        <div class="scenario-group">
                            <div class="scenario-filter">
                                @foreach (var feature in features)
                                {
                                    var key = FeatureKey(report.Category.Id, feature.Id);
                                    var notRatedReason = View.FeatureNotRatedReason(report, feature.Id);
                                    <div class="scenario-row @(notRatedReason is null ? null : "is-not-rated")">
                                        <label class="check-row"
                                               title="@View.FeatureDescription(report, feature.Id)">
                                            <input type="checkbox"
                                                   checked="@_selectedFeatures.Contains(key)"
                                                   @onchange="eventArgs => ToggleFeature(key, eventArgs)"/>
                                            <span>
                                                <span class="feature-order">
                                                    @feature.Order.ToString("00")
                                                </span>@feature.Name
                                            </span>
                                        </label>
                                        @if (notRatedReason is not null)
                                        {
                                            <NotRatedBadge Reason="@notRatedReason"/>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>

                @if (CapabilityCount > 0)
                {
                    <section class="filter-section">
                        <div class="filter-section-head">
                            <SelectAllToggle Selected="@SelectedCapabilityCount"
                                             Total="@CapabilityCount"
                                             OnToggle="ToggleAllCapabilities"/>
                            <h3>Deployment</h3>
                            <span class="filter-count">
                                @SelectedCapabilityCount / @CapabilityCount
                            </span>
                        </div>
                        @foreach (var report in VisibleReports)
                        {
                            var capabilities = DeploymentCapabilities(report).ToArray();
                            if (capabilities.Length == 0)
                            {
                                continue;
                            }

                            <div class="scenario-group">
                                <div class="scenario-filter">
                                    @foreach (var capability in capabilities)
                                    {
                                        var key = CapabilityKey(report.Category.Id, capability.Id);
                                        <div class="scenario-row">
                                            <label class="check-row"
                                                   title="Require Supported or Not applicable for this capability">
                                                <input type="checkbox"
                                                       checked="@_selectedCapabilities.Contains(key)"
                                                       @onchange="eventArgs => ToggleCapability(key, eventArgs)"/>
                                                <span>@capability.Name</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }

                <section class="filter-section filter-section-wide">
                    <div class="filter-section-head">
                        <SelectAllToggle Selected="@SelectedShownCount"
                                         Total="@ShownLibraryCount"
                                         OnToggle="ToggleShownLibraries"/>
                        <h3>Libraries</h3>
                        <span class="filter-count">
                            @SelectedShownCount / @ShownLibraryCount
                        </span>
                    </div>
                    <input class="filter-search"
                           type="search"
                           placeholder="Filter by name"
                           aria-label="Filter libraries by name"
                           @bind="_librarySearch"
                           @bind:event="oninput"
                           @onkeydown="ClearSearchOnEscape"/>
                    @if (ShownLibraryCount == 0)
                    {
                        <p class="muted">
                            @(_librarySearch.Length == 0
                                ? "No libraries match the current filters."
                                : $"Nothing matches “{_librarySearch}”.")
                        </p>
                    }
                    @foreach (var report in VisibleReports)
                    {
                        var libraries = Libraries(report).Where(library => Matches(report, library)).ToArray();
                        if (libraries.Length == 0)
                        {
                            continue;
                        }

                        var medals = Scoring.Rating(report, _selectedLibraries);
                        <div class="library-group">
                            @foreach (var library in libraries)
                            {
                                var key = LibraryKey(report.Category.Id, library.Id);
                                @* The label wraps only the checkbox, so the details
                                   button beside it does not toggle the selection. *@
                                <div class="library-row">
                                    <label class="check-row">
                                        <input type="checkbox"
                                               checked="@_selectedLibraries.Contains(key)"
                                               @onchange="eventArgs => ToggleLibrary(key, eventArgs)"/>
                                        <LibraryLogo Source="@View.Logo(report, library.Id)"
                                                     Name="@library.Name"
                                                     Size="xs"/>
                                        <span>
                                            @library.Name
                                            <small>@library.Version</small>
                                        </span>
                                    </label>
                                    <RatingBadge Category="@report.Category.Name"
                                                 Rated="@View.IsRated(report, library.Id)"
                                                 Standing="@Scoring.Standing(medals, library.Id)"
                                                 Place="@Scoring.Place(medals, library.Id)"/>
                                    <button class="library-info"
                                            type="button"
                                            title="@($"Open the {library.Name} overview")"
                                            aria-label="@($"Open the {library.Name} overview")"
                                            @onclick="() => OpenLibrary(library.Id)">
                                        <svg viewBox="0 0 16 16"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6"
                                             stroke-linecap="round"
                                             aria-hidden="true"
                                             focusable="false">
                                            <circle cx="8" cy="8" r="6.3"/>
                                            <path d="M8 7.2v4"/>
                                            <path d="M8 4.7v.1"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </section>

            </aside>
            </div>

            <main class="content">
                <section class="hero">
                    <div>
                        <p class="eyebrow">Evidence, not faith</p>
                        <h1>Choose with confidence.</h1>
                        <p class="hero-copy">
                            Compare capabilities, execution time and allocations across .NET libraries
                            from reproducible reports.
                        </p>
                    </div>
                </section>

                <nav class="tabs" aria-label="Report views">
                    @foreach (var view in Views)
                    {
                        <button class="@TabClass(view.Id)" @onclick="() => _view = view.Id">
                            <TabIcon View="@view.Id"/>
                            <span>@view.Name</span>
                        </button>
                    }
                    <div class="tabs-summary" aria-label="Report summary">
                        <span><strong>@SelectedLibraryCount</strong> libraries</span>
                        <span><strong>@FeatureCount</strong> scenarios</span>
                    </div>
                </nav>

                @if (_loadingReports)
                {
                    <section class="panel loading-panel">
                        <span class="loader"></span>
                        <p>Loading reports from GitHub…</p>
                    </section>
                }
                else if (_selectedCategoryId is null)
                {
                    <EmptyState Title="Select a category"
                                Text="Choose a library category in the filter panel."/>
                }
                else
                {
                    @if (_catalogWarning is not null)
                    {
                        <div class="notice warning">
                            <strong>Releases:</strong> @_catalogWarning
                        </div>
                    }

                    @foreach (var report in VisibleReports.Where(report => report.Error is not null))
                    {
                        <div class="notice warning">
                            <strong>@report.Category.Name:</strong> @report.Error
                            @* ReSharper disable once UseCollectionExpression *@
                        </div>
                    }

                    @* Every view draws from the selection, so an empty one leaves a
                       blank page. Said once here rather than in each view. *@
                    @* A razor comment between the attributes of a component is passed
                       on as a parameter name and throws at render time, so neither
                       state below carries one. *@
                    @if (SelectedLibraryCount == 0 && ComparesSelection)
                    {
                        <EmptyState Title="No libraries selected"
                                    Text="Pick at least one library in the filter panel to compare."/>
                    }
                    else if (SelectedFeatureCount == 0 && ComparesFeatureSelection)
                    {
                        <EmptyState Title="No scenarios selected"
                                    Text="Pick at least one scenario in the filter panel to compare."/>
                    }
                    else
                    {
                    @switch (_view)
                    {
                        case "features":
                            <FeaturesView Reports="@ComparedReports"
                                          SelectedLibraries="@_selectedLibraries"
                                          OnOpenLibrary="@OpenLibrary"/>
                            break;
                        case "deployment":
                            @* Unlike Features and Benchmarks, Native AOT compatibility is a
                               property of the library, not of which scenario is being compared,
                               so this reads the unrestricted reports rather than ComparedReports. *@
                            <DeploymentView Reports="@VisibleReports.ToArray()"
                                            SelectedLibraries="@_selectedLibraries"
                                            OnOpenLibrary="@OpenLibrary"/>
                            break;
                        case "benchmarks":
                            <BenchmarksView Reports="@ComparedReports"
                                            SelectedLibraries="@_selectedLibraries"
                                            OnOpenLibrary="@OpenLibrary"
                                            OnHelp="@OpenHelp"/>
                            break;
                        case "environment":
                            <EnvironmentView Reports="@VisibleReports.ToArray()"/>
                            break;
                        case "evidence":
                            <EvidenceView Reports="@VisibleReports.ToArray()"
                                          Repository="@_catalog!.Repository"
                                          ReportReference="@SelectedVersion?.Commit"/>
                            break;
                        default:
                            <OverviewView Reports="@ComparedReports"
                                          SelectedLibraries="@_selectedLibraries"
                                          OnOpenLibrary="@OpenLibrary"
                                          OnHelp="@OpenHelp"
                                          LibraryLink="@LibraryLink"/>
                            break;
                    }
                    }
                }
            </main>
        </div>

        @if (OpenReport is { } openReport && OpenLibraryValue is { } openLibrary)
        {
            <LibraryDialog Report="@openReport"
                           Library="@openLibrary"
                           SelectedLibraries="@_selectedLibraries"
                           Link="@LibraryLink(openLibrary.Id)"
                           OnOpenLibrary="@OpenLibrary"
                           OnClose="CloseLibrary"/>
        }

        @if (_help is { } help)
        {
            <HelpDialog Topic="@help" OnClose="CloseHelp"/>
        }
    }
</div>

@code {
    private static readonly (string Id, string Name)[] Views =
    [
        ("overview", "Overview"),
        ("features", "Features"),
        ("deployment", "Deployment"),
        ("benchmarks", "Benchmarks"),
        ("environment", "Environment"),
        ("evidence", "Evidence")
    ];

    private const string CategoryParameter = "category";
    private const string LibraryParameter = "library";
    private const string LibrariesParameter = "libraries";
    private const string FeaturesParameter = "features";
    private const string VersionParameter = "version";
    private const string LatestVersion = "latest";

    /// <summary>
    /// Written when the comparison is empty, because an absent parameter already
    /// means the whole category and the two states have to stay distinguishable.
    /// </summary>
    private const string Nothing = "none";

    /// <summary>
    /// Marks <c>?libraries=</c> or <c>?features=</c> as a list of what to leave out
    /// rather than what to keep, as in <c>?libraries=-MvvmCross,Catel</c>.
    /// </summary>
    private const string Without = "-";

    /// <summary>
    /// A link published elsewhere can name the category to open, as in
    /// <c>?category=dependency-injection</c>. The query string is used rather than a
    /// route because GitHub Pages serves only the root document of this application.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = CategoryParameter)]
    public string? Category { get; set; }

    /// <summary>
    /// Opens the overview of one library, as in <c>?library=sep</c>. The category is
    /// found from the library, so a page about a library needs only this one value.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = LibraryParameter)]
    public string? Library { get; set; }

    /// <summary>
    /// Narrows the comparison, as in <c>?libraries=Pure.DI,DryIoc,Grace</c>, or names
    /// what to leave out, as in <c>?libraries=-MvvmCross,Catel</c>. This belongs in
    /// the address because it belongs in the result: points are measured against the
    /// best of the compared libraries, so a link that dropped the selection would
    /// show different numbers under the same names. Absent means the whole category,
    /// which is why the default view carries no parameter.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = LibrariesParameter)]
    public string? ComparedLibraries { get; set; }

    /// <summary>
    /// Narrows the comparison to some of the scenarios, as in
    /// <c>?features=QuotedFields,WriteRows</c>, or names what to leave out, as in
    /// <c>?features=-AsyncRead</c>. It belongs in the address for the same reason
    /// <c>?libraries=</c> does: a score is the sum over the scenarios compared, so
    /// a link that dropped the selection would show a different rating under the
    /// same names. Absent means every scenario of the category.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = FeaturesParameter)]
    public string? ComparedFeatures { get; set; }

    /// <summary>
    /// Pins the reports to one release, as in <c>?version=1.4.0</c>. Absent, or
    /// <c>latest</c>, means the newest entry of the catalog.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = VersionParameter)]
    public string? Version { get; set; }

    private MatrixWebCatalog? _catalog;
    private string? _openLibraryId;
    private IReadOnlyList<CategoryReport> _reports = [];
    private string? _selectedCategoryId;
    private readonly HashSet<string> _selectedLibraries = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedFeatures = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// Deployment capabilities required of a shown library, unlike <see cref="_selectedFeatures"/>
    /// and <see cref="_selectedLibraries"/>: those default to everything, because unchecking one
    /// removes it from the comparison. A capability defaults to unchecked — nothing is required —
    /// so a first-time visitor never sees the library list narrowed by a filter they never touched.
    /// </summary>
    private readonly HashSet<string> _selectedCapabilities = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedVersion;
    private string _view = "overview";
    private bool _loadingCatalog = true;
    private bool _loadingReports;
    private string? _fatalError;
    private string? _catalogWarning;
    private string _librarySearch = string.Empty;
    private string _featureSearch = string.Empty;

    private MatrixVersion? SelectedVersion =>
        _catalog?.Versions.FirstOrDefault(version => version.Version == _selectedVersion);

    private IEnumerable<CategoryReport> VisibleReports =>
        _reports.Where(report => report.Category.Id.Equals(
            _selectedCategoryId,
            StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// What the comparing views are given: the same reports with the scenarios the
    /// visitor left out removed, so the matrix, the charts and the rating are read
    /// off one set of scenarios. Taking everything returns the reports unchanged,
    /// so the default view costs nothing.
    /// </summary>
    private CategoryReport[] ComparedReports =>
        [.. VisibleReports.Select(report => View.Restrict(report, _selectedFeatures))];

    /// <summary>
    /// The environment and the evidence describe how the reports were produced, not
    /// what is being compared, so neither selection applies to them.
    /// </summary>
    private bool ComparesSelection => _view != "environment" && _view != "evidence";

    /// <summary>
    /// Deployment compatibility is a property of the library, not of which scenario a visitor
    /// happens to be comparing, so an empty scenario selection must not blank this tab out.
    /// </summary>
    private bool ComparesFeatureSelection => ComparesSelection && _view != "deployment";

    private IEnumerable<(CategoryReport Report, (int Order, string Id, string Name) Feature)>
        CategoryFeatures => VisibleReports
        .SelectMany(report => View.Features(report).Select(feature => (report, feature)));

    /// <summary>
    /// Every scenario of the category that is selected, whatever the name filter
    /// currently lists. This is what decides whether there is anything to compare.
    /// </summary>
    private int SelectedFeatureCount => CategoryFeatures
        .Count(entry => _selectedFeatures.Contains(
            FeatureKey(entry.Report.Category.Id, entry.Feature.Id)));

    /// <summary>
    /// The rows the name filter currently leaves visible, as with the libraries:
    /// narrowing the list and taking everything shown is one move.
    /// </summary>
    private IEnumerable<string> ShownFeatureKeys => VisibleReports
        .SelectMany(report => View.Features(report)
            .Where(MatchesFeature)
            .Select(feature => FeatureKey(report.Category.Id, feature.Id)));

    private int ShownFeatureCount => ShownFeatureKeys.Count();

    private int SelectedShownFeatureCount => ShownFeatureKeys.Count(_selectedFeatures.Contains);

    /// <summary>
    /// How many of the currently shown scenarios carry a stated reason not to be
    /// rated, so the panel's count line does not silently include them in what
    /// looks like a plain total.
    /// </summary>
    private int ShownNotRatedFeatureCount => VisibleReports
        .SelectMany(report => View.Features(report)
            .Where(MatchesFeature)
            .Where(feature => !View.IsFeatureRated(report, feature.Id)))
        .Count();

    private int CategoryFeatureCount => CategoryFeatures.Count();

    private bool HasFeatureFilter => SelectedFeatureCount < CategoryFeatureCount;

    private IReadOnlyList<string> CategoryFeatureNameItems => CategoryFeatures
        .Select(entry => entry.Feature.Name)
        .ToArray();

    private IReadOnlyList<string> SelectedFeatureNameItems => CategoryFeatures
        .Where(entry => _selectedFeatures.Contains(
            FeatureKey(entry.Report.Category.Id, entry.Feature.Id)))
        .Select(entry => entry.Feature.Name)
        .ToArray();

    private string SelectedFeatureNames => SelectionNames(SelectedFeatureNameItems);

    private string FeatureSelectionSummary => SelectionSummary(
        CategoryFeatureNameItems,
        SelectedFeatureNameItems);

    /// <summary>
    /// The displayed name and the id both match: a scenario is written as
    /// "Read Simple Rows" in the list and as ReadSimpleRows in a link.
    /// </summary>
    private bool MatchesFeature((int Order, string Id, string Name) feature) =>
        _featureSearch.Length == 0
        || feature.Name.Contains(_featureSearch, StringComparison.OrdinalIgnoreCase)
        || feature.Id.Contains(_featureSearch, StringComparison.OrdinalIgnoreCase);

    private int SelectedLibraryCount => VisibleReports
        .SelectMany(Libraries)
        .Count(library => _selectedLibraries.Contains(
            LibraryKey(_selectedCategoryId!, library.Id)));

    private int CategoryLibraryCount => VisibleReports.SelectMany(Libraries).Count();

    private bool HasLibraryFilter => SelectedLibraryCount < CategoryLibraryCount;

    private IReadOnlyList<string> CategoryLibraryNameItems => VisibleReports
        .SelectMany(report => Libraries(report).Select(library => library.Name))
        .ToArray();

    private IReadOnlyList<string> SelectedLibraryNameItems => VisibleReports
        .SelectMany(report => Libraries(report)
            .Where(library => _selectedLibraries.Contains(
                LibraryKey(report.Category.Id, library.Id)))
            .Select(library => library.Name))
        .ToArray();

    private string SelectedLibraryNames => SelectionNames(SelectedLibraryNameItems);

    private string LibrarySelectionSummary => SelectionSummary(
        CategoryLibraryNameItems,
        SelectedLibraryNameItems);

    private static string SelectionNames(IReadOnlyList<string> names) =>
        names.Count == 0 ? "None" : string.Join(", ", names);

    private static string SelectionSummary(
        IReadOnlyList<string> all,
        IReadOnlyList<string> selected)
    {
        if (selected.Count == 0)
        {
            return "None";
        }

        if (selected.Count <= 3)
        {
            return string.Join(", ", selected);
        }

        var selectedNames = selected.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var excluded = all.Where(name => !selectedNames.Contains(name)).ToArray();
        return excluded.Length <= 3
            ? $"Except {string.Join(", ", excluded)}"
            : $"{selected.Count} of {all.Count} selected";
    }

    /// <summary>
    /// The rows the name filter currently leaves visible. Bulk selection works on
    /// this set, so narrowing the list and taking everything shown is one move.
    /// </summary>
    private IEnumerable<string> ShownLibraryKeys => VisibleReports
        .SelectMany(report => Libraries(report)
            .Where(library => Matches(report, library))
            .Select(library => LibraryKey(report.Category.Id, library.Id)));

    private int ShownLibraryCount => ShownLibraryKeys.Count();

    private int SelectedShownCount => ShownLibraryKeys.Count(_selectedLibraries.Contains);

    private string SelectedCategoryName => _catalog?.Categories
        .FirstOrDefault(category => category.Id.Equals(
            _selectedCategoryId,
            StringComparison.OrdinalIgnoreCase))
        ?.Name ?? "No category";

    private bool Matches(CategoryReport report, MatrixLibrary library) =>
        (_librarySearch.Length == 0
         || library.Name.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase)
         // Reports may omit the package, the hand-coded baseline has none.
         || library.Package?.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase) == true)
        && RequiredCapabilities(report).All(capability => IsCompatible(capability, library));

    /// <summary>
    /// Every deployment capability of the category — Native AOT today, and whatever else the
    /// matrix probes for later — read straight from the report rather than named here, so a
    /// second capability shows up as a second checkbox without a code change.
    /// </summary>
    private static IEnumerable<FeatureReportEntry> DeploymentCapabilities(CategoryReport report) =>
        (report.Features?.Features ?? [])
            .Where(feature => feature.IsDeployment)
            .OrderBy(feature => feature.Order);

    private IEnumerable<FeatureReportEntry> RequiredCapabilities(CategoryReport report) =>
        DeploymentCapabilities(report)
            .Where(capability => _selectedCapabilities.Contains(
                CapabilityKey(report.Category.Id, capability.Id)));

    /// <summary>
    /// True when this capability reports the library as Supported or Not applicable. A
    /// capability with no result for the library never disqualifies it — a probe that never ran
    /// for this library is not evidence it fails.
    /// </summary>
    private static bool IsCompatible(FeatureReportEntry capability, MatrixLibrary library) =>
        capability.Results
            .Where(result => result.LibraryId.Equals(library.Id, StringComparison.OrdinalIgnoreCase))
            .All(result => result.Status is "Supported" or "NotApplicable");

    private IEnumerable<(string CategoryId, FeatureReportEntry Capability)> CategoryCapabilities =>
        VisibleReports.SelectMany(report => DeploymentCapabilities(report)
            .Select(capability => (report.Category.Id, capability)));

    private int CapabilityCount => CategoryCapabilities.Count();

    private int SelectedCapabilityCount => CategoryCapabilities
        .Count(entry => _selectedCapabilities.Contains(CapabilityKey(entry.CategoryId, entry.Capability.Id)));

    private void ToggleAllCapabilities()
    {
        var keys = CategoryCapabilities
            .Select(entry => CapabilityKey(entry.CategoryId, entry.Capability.Id))
            .ToArray();
        if (keys.Length > 0 && keys.All(_selectedCapabilities.Contains))
        {
            _selectedCapabilities.ExceptWith(keys);
        }
        else
        {
            _selectedCapabilities.UnionWith(keys);
        }

        ApplyCapabilityRequirement();
    }

    private void ToggleCapability(string key, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _selectedCapabilities.Add(key);
        }
        else
        {
            _selectedCapabilities.Remove(key);
        }

        ApplyCapabilityRequirement();
    }

    /// <summary>
    /// Deployment compatibility is a requirement on which libraries take part in the
    /// comparison, not merely on which rows the Libraries list shows — so a change here updates
    /// <see cref="_selectedLibraries"/> directly, the same way checking a library there changes
    /// what Overview, Benchmarks and Deployment show. The name search is deliberately left out
    /// of the requirement checked here: it stays what it has always been, a way to find a row in
    /// a long list, not a second thing that can silently narrow the comparison.
    /// </summary>
    private void ApplyCapabilityRequirement()
    {
        foreach (var report in VisibleReports)
        {
            foreach (var library in Libraries(report))
            {
                var key = LibraryKey(report.Category.Id, library.Id);
                if (RequiredCapabilities(report).All(capability => IsCompatible(capability, library)))
                {
                    _selectedLibraries.Add(key);
                }
                else
                {
                    _selectedLibraries.Remove(key);
                }
            }
        }

        RememberSelection();
    }

    private static string CapabilityKey(string categoryId, string capabilityId) =>
        $"{categoryId}{capabilityId}";

    private void ToggleShownLibraries()
    {
        var keys = ShownLibraryKeys.ToArray();
        if (keys.Length > 0 && keys.All(_selectedLibraries.Contains))
        {
            _selectedLibraries.ExceptWith(keys);
        }
        else
        {
            _selectedLibraries.UnionWith(keys);
        }

        RememberSelection();
