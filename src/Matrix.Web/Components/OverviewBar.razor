@using System.Globalization

<div class="overview-metric">
    @* Only shown where the row is stacked and the column headings are gone. *@
    <span class="overview-metric-label">@(Memory ? "Memory" : "Time")</span>
    <div class="overview-bar">
        @if (_total > 0)
        {
            @for (var index = 0; index < Values.Count; index++)
            {
                var share = (Values[index] ?? 0) / _total;
                if (share > 0)
                {
                    <span style="width: @Percent(_filled * share); background: @MatrixChartPalette.Feature(index)"
                          title="@SegmentTitle(index)"></span>
                }
            }
        }
        else if (_hasValues)
        {
            <span class="overview-bar-zero" style="background: @MatrixChartPalette.Feature(0)"></span>
        }
    </div>
    <strong>@Label</strong>
</div>

@code {
    private bool _hasValues;
    private double _total;
    private double _filled;

    [Parameter, EditorRequired]
    public required IReadOnlyList<double?> Values { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<string> FeatureNames { get; set; }

    [Parameter, EditorRequired]
    public required double Maximum { get; set; }

    [Parameter]
    public bool Memory { get; set; }

    private string Label => _hasValues
        ? MatrixMetrics.Format(_total, Memory)
        : "n/a";

    protected override void OnParametersSet()
    {
        _hasValues = MatrixMetrics.HasValues(Values);
        _total = MatrixMetrics.Total(Values);
        _filled = MatrixMetrics.ScalePercent(_total, Maximum);
    }

    private string SegmentTitle(int index)
    {
        var name = index < FeatureNames.Count ? FeatureNames[index] : string.Empty;
        return $"{name}: {MatrixMetrics.Format(Values[index] ?? 0, Memory)}";
    }

    private static string Percent(double value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture) + "%";
}
