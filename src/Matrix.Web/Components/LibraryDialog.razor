@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@inject IMatrixView View
@inject IMatrixScoring Scoring
@inject IMatrixMeasures Measures
@inject IMatrixPalette Palette

@* Dimming overlay. Clicking it closes; the panel stops the click from reaching it. *@
<div class="modal-backdrop" @onclick="CloseAsync">
    <div class="modal-panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="library-dialog-title"
         tabindex="-1"
         @ref="_panel"
         @onclick:stopPropagation="true"
         @onkeydown="CloseOnEscapeAsync">
        <header class="modal-head">
            <LibraryLogo Source="@View.Logo(Report, Library.Id)" Name="@Library.Name"/>
            <div class="modal-identity">
                <h2 id="library-dialog-title">@Library.Name</h2>
                <p class="modal-package">
                    @if (Library.Package is { Length: > 0 } package)
                    {
                        <span>@package</span>
                    }
                    @if (Library.Version is { Length: > 0 } version)
                    {
                        <span>@version</span>
                    }
                    @if (Library.Baseline)
                    {
                        <span>baseline</span>
                    }
                </p>
            </div>
            <div class="modal-head-end">
                <span class="category-chip">@Report.Category.Name</span>
                <RatingBadge Category="@Report.Category.Name"
                             Rated="@View.IsRated(Report, Library.Id)"
                             Standing="@_medals"
                             Place="@_place"/>
                <CopyLinkButton Url="@Link" Caption="Copy link"/>
                <button class="modal-close"
                        type="button"
                        title="Close (Esc)"
                        aria-label="Close"
                        @onclick="CloseAsync">
                    <svg viewBox="0 0 16 16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         aria-hidden="true"
                         focusable="false">
                        <path d="M4.4 4.4l7.2 7.2M11.6 4.4l-7.2 7.2"/>
                    </svg>
                </button>
            </div>
        </header>

        <div class="modal-body">
            @if (_metadata is { } metadata)
            {
                <p class="modal-description">@metadata.Description</p>
                <div class="modal-links">
                    @if (metadata.DocumentationUrl is { Length: > 0 } documentation)
                    {
                        <a href="@documentation" target="_blank" rel="noreferrer">Documentation ↗</a>
                    }
                    @if (metadata.RepositoryUrl is { Length: > 0 } repository)
                    {
                        <a href="@repository" target="_blank" rel="noreferrer">Repository ↗</a>
                    }
                    @if (PackageUrl is { } packageUrl)
                    {
                        <a href="@packageUrl" target="_blank" rel="noreferrer">NuGet ↗</a>
                    }
                </div>
            }

            <div class="modal-metrics">
                <div>
                    <strong>@RatingPlace</strong>
                    <span>rating</span>
                </div>
                <div class="is-explained"
                     style="--points-time: @Share(_medals?.TimePoints ?? 0, _medals?.Maximum ?? 0); --points: @Share(_medals?.Points ?? 0, _medals?.Maximum ?? 0)"
                     title="@PointsTitle">
                    <strong>@(_medals is null ? "0" : Scoring.Format(_medals.Points))<small>/@(_medals?.Maximum ?? 0)</small></strong>
                    <span>points</span>
                </div>
                <div>
                    <strong>@_supported<small>/@_rows.Length</small></strong>
                    <span>scenarios supported</span>
                </div>
            </div>

            @* Where the number came from, itemised: the dialog is an entry point
               of its own, reachable by link without ever seeing the standings. *@
            @if (_medals is { } rating)
            {
                <section class="modal-section">
                    <div class="modal-section-head">
                        <h3>Rating</h3>
                        <span class="section-meta">
                            @RatingPlace of @_rated · compared with @Compared selected
                        </span>
                    </div>
                    @* Each number carries the measurements it was summed from, so
                       the breakdown can be checked without leaving the card. *@
                    <ul class="modal-rating">
                        <li class="is-time" style="--points: @Share(rating.TimePoints, rating.MetricMaximum)" title="@Hint(false)">
                            <span>Execution time</span>
                            <strong>@Scoring.Format(rating.TimePoints)</strong>
                            <small>of @rating.MetricMaximum</small>
                        </li>
                        <li class="is-memory" style="--points: @Share(rating.MemoryPoints, rating.MetricMaximum)" title="@Hint(true)">
                            <span>Allocated memory</span>
                            <strong>@Scoring.Format(rating.MemoryPoints)</strong>
                            <small>of @rating.MetricMaximum</small>
                        </li>
                        @if (rating.Covered < rating.Scenarios)
                        {
                            var missing = rating.Scenarios - rating.Covered;
                            <li class="is-missing" title="@MissingTitle">
                                <span>@missing scenario@(missing == 1 ? "" : "s") not supported</span>
                                <strong>0</strong>
                                <small>of @(missing * Scoring.MaximumPoints * Scoring.Metrics)</small>
                            </li>
                        }
                        <li class="is-total"
                            style="--points-time: @Share(rating.TimePoints, rating.Maximum); --points: @Share(rating.Points, rating.Maximum)"
                            title="@Hint(null)">
                            <span>Rating</span>
                            <strong>@Scoring.Format(rating.Points)</strong>
                            <small>of @rating.Maximum</small>
                        </li>
                    </ul>
                </section>
            }

            @if (_standings.Length > 0)
            {
                <section class="modal-section">
                    <div class="modal-section-head">
                        <h3>Overview standing</h3>
                        <span class="section-meta">@Compared compared · lower is better</span>
                    </div>
                    @foreach (var standing in _standings)
                    {
                        <div class="modal-standing">
                            <div class="modal-standing-head">
                                <strong>@standing.Group.Name</strong>
                                <span>
                                    <span class="modal-standing-score"
                                          title="@standing.Hint">@standing.Rank</span>
                                    @* The library it is measured against was named in
                                       a tooltip only, and led nowhere. *@
                                    @if (standing.Leader is { } leader)
                                    {
                                        <text> · behind </text>
                                        <button class="library-open"
                                                type="button"
                                                title="@($"Open the {leader.Name} overview")"
                                                @onclick="() => OnOpenLibrary.InvokeAsync(leader.LibraryId)">
                                            @leader.Name
                                        </button>
                                    }
                                </span>
                            </div>
                            <div class="modal-standing-row">
                                <span class="modal-standing-metric">Performance</span>
                                <OverviewBar Values="@standing.Row.PerformanceValues"
                                             FeatureNames="@standing.FeatureNames"
                                             Maximum="@standing.Overview.MaximumTime"/>
                                <span class="modal-standing-ratio" title="@standing.TimeTitle">
                                    @standing.TimeRatio
                                </span>
                            </div>
                            <div class="modal-standing-row">
                                <span class="modal-standing-metric">Memory</span>
                                <OverviewBar Values="@standing.Row.MemoryValues"
                                             FeatureNames="@standing.FeatureNames"
                                             Maximum="@standing.Overview.MaximumMemory"
                                             Memory="true"/>
                                <span class="modal-standing-ratio" title="@standing.MemoryTitle">
                                    @standing.MemoryRatio
                                </span>
                            </div>
                        </div>
                    }
                    @if (_legend.Length > 0)
                    {
                        <ul class="overview-chart-legend">
                            @for (var index = 0; index < _legend.Length; index++)
                            {
                                <li title="@_legend[index].Title">
                                    <span class="overview-chart-swatch"
                                          style="background: @Palette.Feature(index)"></span>
                                    @_legend[index].Name
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @* Support and measurement are one list: the two reports name the same
               scenarios, and a missing result is explained by the status beside it. *@
            @if (_rows.Length > 0)
            {
                <section class="modal-section">
                    <div class="modal-section-head">
                        <h3>Scenarios</h3>
                        <span class="section-meta">
                            @_supported of @_rows.Length supported · ratio against the best of @Compared
                            @if (_scored)
                            {
                                <text> · points out of @(Scoring.MaximumPoints * Scoring.Metrics) each</text>
                            }
                        </span>
                    </div>
                    <div class="modal-scenarios">
                        <table>
                            <thead>
                            <tr>
                                <th>Scenario</th>
                                <th>Time</th>
                                <th>Memory</th>
                                @* The rating in full, on the page rather than in a
                                   hint: a tooltip never opens on a touch screen, and
                                   this is the one place the score is the subject. *@
                                @if (_scored)
                                {
                                    <th class="modal-scenario-points">Points</th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in _rows)
                            {
                                <tr class="@(row.HasResult ? null : "is-quiet")"
                                    style="@(_scored ? $"--points-time: {Share(row.TimePoints, ScenarioMaximum)}; --points: {Share(row.Points, ScenarioMaximum)}" : null)">
                                    <td>
                                        <span class="modal-scenario-name" title="@row.Description">
                                            <span class="feature-status @row.StatusClass"
                                                  title="@row.StatusLabel">
                                                <StatusIcon Kind="@row.StatusClass"/>
                                            </span>
                                            <span>
                                                <span class="feature-order">@row.Order.ToString("00")</span>@row.Name
                                            </span>
                                        </span>
                                    </td>
                                    @if (row.HasResult)
                                    {
                                        <td>
                                            <span class="modal-scenario-metric">
                                                <span class="meter">
                                                    <span class="is-performance"
                                                          style="@Width(row.TimePercent)"></span>
                                                </span>
                                                <strong>@row.Time</strong>
                                                <small class="@Best(row.TimeRatio)">@row.TimeRatio</small>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="modal-scenario-metric">
                                                <span class="meter">
                                                    <span class="is-memory"
                                                          style="@Width(row.MemoryPercent)"></span>
                                                </span>
                                                <strong>@row.Memory</strong>
                                                <small class="@Best(row.MemoryRatio)">@row.MemoryRatio</small>
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="modal-scenario-note" colspan="2">@row.Note</td>
                                    }
                                    @if (_scored)
                                    {
                                        <td class="modal-scenario-points">
                                            <strong>@Scoring.FormatExact(row.Points)</strong>
                                            @* The split, because time and memory are
                                               separate columns in the standings. *@
                                            <small>
                                                @Scoring.FormatExact(row.TimePoints)
                                                + @Scoring.FormatExact(row.MemoryPoints)
                                            </small>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                            @if (_scored && _medals is { } total)
                            {
                                <tfoot>
                                <tr style="@($"--points-time: {Share(total.TimePoints, total.Maximum)}; --points: {Share(total.Points, total.Maximum)}")">
                                    <td colspan="3">Rating</td>
                                    <td class="modal-scenario-points">
                                        <strong>@Scoring.Format(total.Points)</strong>
                                        <small>of @total.Maximum</small>
                                    </td>
                                </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    private ElementReference _panel;
    private bool _focused;
    private MatrixLibraryMetadata? _metadata;
    private MatrixMedals? _medals;
    private int? _place;
    private int _rated;
    private int _supported;
    /// <summary>The library takes part in the rating, so its scenarios carry points.</summary>
    private bool _scored;

    private Standing[] _standings = [];
    private (string Name, string Title)[] _legend = [];
    private Row[] _rows = [];
    private IReadOnlyDictionary<string, MatrixScoreDetail> _scores =
        new Dictionary<string, MatrixScoreDetail>();

    [Parameter, EditorRequired]
    public required CategoryReport Report { get; set; }

    [Parameter, EditorRequired]
    public required MatrixLibrary Library { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    /// <summary>The address that reopens this dialog, offered for copying.</summary>
    [Parameter, EditorRequired]
    public required string Link { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    private int Compared => View
        .Libraries(Report)
        .Count(library => View.IsSelected(Report, SelectedLibraries, library.Id));

    private string RatingPlace { get; set; } = "—";

    private string? PointsTitle => _medals is null ? null : Hint(null);

    /// <summary>Which scenarios the zero is made of; the row states only how many.</summary>
    private string MissingTitle =>
        Report.Benchmarks is { } benchmarks
            ? "Scored nothing here:\n"
              + string.Join(
                  '\n',
                  MatrixScores
                      .Explain(benchmarks.Features, Library.Id, _ => true)
                      .Where(detail => !detail.Covered)
                      .Select(detail => $"  {detail.Name}"))
            : string.Empty;

    /// <summary>
    /// The measurements behind one of the numbers on this card, as shown wherever
    /// else the same number appears.
    /// </summary>
    private string Hint(bool? metric) =>
        Report.Benchmarks is { } benchmarks
            ? Scoring.Hint(
                Report,
                benchmarks.Features,
                SelectedLibraries,
                Library.Id,
                metric)
            : string.Empty;

    private string? PackageUrl => Library.Package is { Length: > 0 } package
        ? $"https://www.nuget.org/packages/{package}"
        : null;

    protected override void OnParametersSet()
    {
        _metadata = View.Metadata(Report, Library.Id);
        var rating = Scoring.Rating(Report, SelectedLibraries);
        _medals = Scoring.Standing(rating, Library.Id);
        _place = Scoring.Place(rating, Library.Id);
        _rated = rating.Count;
        RatingPlace = _place is { } place ? $"{place}{Suffix(place)}" : "—";
        _scored = View.IsRated(Report, Library.Id) && _medals is not null;
        ReadStandings();
        ReadRows();
    }

    /// <summary>
    /// Focus moves into the panel once, so Escape reaches the key handler and the
    /// tab order starts inside the dialog rather than behind it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focused)
        {
            _focused = true;
            await _panel.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task CloseOnEscapeAsync(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    /// <summary>
    /// The feature report and the benchmark report name the same scenarios, so one
    /// row carries both: whether the library supports it and what it costs. A
    /// scenario present in only one of the two reports still gets its row.
    /// </summary>
    private void ReadRows()
    {
        var order = new Dictionary<string, (int Order, string Name)>(StringComparer.OrdinalIgnoreCase);
        foreach (var feature in Report.Benchmarks?.Features ?? [])
        {
            order[feature.Id] = (feature.Order, feature.Name);
        }

        // The feature report wins the name: it is the one the matrix shows.
        foreach (var feature in Report.Features?.Features ?? [])
        {
            order[feature.Id] = (feature.Order, feature.Name);
        }

        // The rating, scenario by scenario, from the function the rating itself sums.
        _scores = Report.Benchmarks is { } benchmarks
            ? MatrixScores
                .Explain(
                    benchmarks.Features,
                    Library.Id,
                    libraryId => View.IsRated(Report, libraryId)
                                 && View.IsSelected(Report, SelectedLibraries, libraryId))
                .ToDictionary(detail => detail.FeatureId, StringComparer.OrdinalIgnoreCase)
            : [];
        _rows = order
            .OrderBy(entry => entry.Value.Order)
            .Select(entry => ReadRow(entry.Key, entry.Value.Order, entry.Value.Name))
            .ToArray();
        _supported = _rows.Count(row => row.StatusClass == "supported");
    }

    private Row ReadRow(string featureId, int order, string name)
    {
        var score = _scores.GetValueOrDefault(featureId);
        var status = (Report.Features?.Features ?? [])
            .FirstOrDefault(feature => feature.Id.Equals(featureId, StringComparison.OrdinalIgnoreCase))
            ?.Results
            .FirstOrDefault(result =>
                result.LibraryId.Equals(Library.Id, StringComparison.OrdinalIgnoreCase));
        var scenario = Report.Benchmarks is { } benchmarks
            ? benchmarks.Features.FirstOrDefault(feature =>
                feature.Id.Equals(featureId, StringComparison.OrdinalIgnoreCase))
            : null;
        var rows = scenario is null
            ? []
            : View.Scenarios(Report, scenario, SelectedLibraries);
        var row = rows.FirstOrDefault(item =>
            item.LibraryId.Equals(Library.Id, StringComparison.OrdinalIgnoreCase));
        return new Row(
            order,
            name,
            View.FeatureDescription(Report, featureId),
            StatusClass(status?.Status),
            StatusLabel(status?.Status),
            Note(status),
            row is not null,
            Value(row?.Time, false),
            Value(row?.Memory, true),
            Measures.ScalePercent(row?.Time ?? 0, View.Worst(rows, false)),
            Measures.ScalePercent(row?.Memory ?? 0, View.Worst(rows, true)),
            Ratio(row?.Time, View.Best(rows, false)),
            Ratio(row?.Memory, View.Best(rows, true)),
            score?.Time.Points ?? 0,
            score?.Memory.Points ?? 0);
    }

    private void ReadStandings()
    {
        if (Report.Benchmarks is null || Report.ChartCatalog is not { } charts)
        {
            _standings = [];
            _legend = [];
            return;
        }

        var standings = new List<Standing>();
        // ReSharper disable once LoopCanBeConvertedToQuery
        foreach (var group in charts.Groups)
        {
            var overview = View.Overview(Report, group, SelectedLibraries);
            if (overview is null)
            {
                continue;
            }

            var rank = overview.Rows.ToList().FindIndex(item =>
                item.LibraryId.Equals(Library.Id, StringComparison.OrdinalIgnoreCase));
            if (rank < 0)
            {
                continue;
            }

            var row = overview.Rows[rank];
            var rated = overview.Rows.Count(item => item.Rated);
            var leader = overview.Rows.FirstOrDefault(item => item.Rated);
            standings.Add(new Standing(
                group,
                overview,
                row,
                overview.Features
                    .Select(feature => View.FeatureDescription(Report, feature.Id) is { } text
                        ? $"{feature.Name} — {text}"
                        : feature.Name)
                    .ToArray(),
                row.Rated
                    ? $"{Scoring.Format(row.Points)} of {overview.Maximum} points"
                      + $" · rank {rank + 1} of {rated}"
                    : "reference · not part of the rating",
                row.Rated
                    ? Scoring.Hint(
                        Report,
                        overview.Features,
                        SelectedLibraries,
                        Library.Id,
                        null)
                    : "Outside the rating: shown as a reference only",
                row.Rated && rank > 0 ? leader : null,
                Ratio(row.PerformanceValues, leader?.PerformanceValues),
                Ratio(row.MemoryValues, leader?.MemoryValues),
                Title(leader, false),
                Title(leader, true)));
        }

        _standings = [.. standings];
        _legend = standings
            .SelectMany(standing => standing.Overview.Features)
            .DistinctBy(feature => feature.Id, StringComparer.OrdinalIgnoreCase)
            .Select(feature => (
                feature.Name,
                View.FeatureDescription(Report, feature.Id) ?? feature.Name))
            .ToArray();
    }

    /// <summary>
    /// Stands in for the two numeric columns, so the row explains its own gap. A
    /// supported scenario with no result is a hole in the report, not a limitation
    /// of the library, and says so.
    /// </summary>
    private static string Note(FeatureResult? status) => status switch
    {
        { Reason: { Length: > 0 } reason } => $"{StatusLabel(status.Status)} — {reason}",
        { Status: "Supported" } => "No benchmark result",
        null => "No benchmark result",
        _ => StatusLabel(status.Status)
    };

    private string Value(double? value, bool memory) =>
        value is null ? "n/a" : Measures.Format(value.Value, memory);

    private string Ratio(double? current, double minimum) =>
        current is null ? "" : Measures.Ratio(current.Value, minimum);

    /// <summary>How this library compares with the leader of the whole overview.</summary>
    private string Ratio(
        IReadOnlyList<double?> values,
        IReadOnlyList<double?>? leader) =>
        leader is null
            ? ""
            : Measures.Ratio(Measures.Total(values), Measures.Total(leader));

    private string Title(MatrixOverviewRow? leader, bool memory) =>
        leader is null
            ? string.Empty
            : leader.LibraryId.Equals(Library.Id, StringComparison.OrdinalIgnoreCase)
                ? "Best result in this overview"
                : $"Against {leader.Name}, the fastest of the compared libraries"
                  + $": {Measures.Format(Measures.Total(memory ? leader.MemoryValues : leader.PerformanceValues), memory)}";

    private static string Width(double percent) =>
        $"width: {percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    /// <summary>What one scenario is worth on both metrics, the denominator every row's fill shares.</summary>
    private int ScenarioMaximum => Scoring.MaximumPoints * Scoring.Metrics;

    /// <summary>
    /// The share of a maximum a value holds, as the width of its fill.
    /// Invariant, because a decimal comma is not a CSS length.
    /// </summary>
    private static string Share(double points, int maximum) =>
        maximum > 0
            ? (100d * points / maximum).ToString("0.##", CultureInfo.InvariantCulture) + "%"
            : "0%";

    private static string? Best(string ratio) => ratio == "1.00x" ? "is-best" : null;

    private static string Suffix(int place) => place switch
    {
        1 => "st",
        2 => "nd",
        3 => "rd",
        _ => "th"
    };

    private static string StatusClass(string? status) => status switch
    {
        "Supported" => "supported",
        "Unsupported" => "unsupported",
        "NotApplicable" => "not-applicable",
        "Failed" => "failed",
        _ => "missing"
    };

    private static string StatusLabel(string? status) => status switch
    {
        "Supported" => "Supported",
        "Unsupported" => "Unsupported",
        "NotApplicable" => "Not applicable",
        "Failed" => "Failed",
        _ => "No data"
    };

    [SuppressMessage("ReSharper", "MemberHidesStaticFromOuterClass")]
    private sealed record Standing(
        MatrixChartGroup Group,
        MatrixOverview Overview,
        MatrixOverviewRow Row,
        string[] FeatureNames,
        string Rank,
        string Hint,
        MatrixOverviewRow? Leader,
        string TimeRatio,
        string MemoryRatio,
        string TimeTitle,
        string MemoryTitle);

    [SuppressMessage("ReSharper", "MemberHidesStaticFromOuterClass")]
    private sealed record Row(
        int Order,
        string Name,
        string? Description,
        string StatusClass,
        string StatusLabel,
        string Note,
        bool HasResult,
        string Time,
        string Memory,
        double TimePercent,
        double MemoryPercent,
        string TimeRatio,
        string MemoryRatio,
        double TimePoints,
        double MemoryPoints)
    {
        public double Points => TimePoints + MemoryPoints;
    }
}
