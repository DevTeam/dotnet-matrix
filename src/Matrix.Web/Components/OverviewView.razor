@inject IMatrixView View
@inject IMatrixScoring Scoring

@foreach (var report in Reports)
{
    if (report.ChartCatalog is not { Groups.Count: > 0 } chartCatalog
        || report.Benchmarks is null)
    {
        continue;
    }

    var medals = Scoring.Rating(report, SelectedLibraries);
    <section class="overview-report">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@report.Category.Name</p>
                <h2>Benchmark report</h2>
            </div>
            <span class="section-meta">Performance · Memory</span>
        </div>
        <RatingBoard Report="@report"
                     Medals="@medals"
                     SelectedLibraries="@SelectedLibraries"
                     OnOpenLibrary="@OnOpenLibrary"
                     OnHelp="@OnHelp"/>
        @foreach (var group in chartCatalog.Groups)
        {
            <OverviewChart Report="@report"
                           Group="@group"
                           SelectedLibraries="@SelectedLibraries"
                           OnOpenLibrary="@OnOpenLibrary"
                           OnHelp="@(group == chartCatalog.Groups[0] ? OnHelp : default)"/>
        }
    </section>
}

<section class="overview-grid">
    @foreach (var report in Reports)
    {
        var libraries = View.Libraries(report)
            .Where(library => View.IsSelected(report, SelectedLibraries, library.Id))
            .Where(library => View.Metadata(report, library.Id) is not null)
            .ToArray();
        var cardMedals = Scoring.Rating(report, SelectedLibraries);
        @foreach (var library in libraries)
        {
            var metadata = View.Metadata(report, library.Id);
            var featureResults = (report.Features?.Features ?? [])
                .SelectMany(feature => feature.Results)
                .Where(result => result.LibraryId.Equals(library.Id, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            var supported = featureResults.Count(result => result.Status == "Supported");
            var unavailable = featureResults.Count(result =>
                result.Status is "Unsupported" or "NotApplicable");
            var benchmarkResults = (report.Benchmarks?.Features ?? [])
                .SelectMany(feature => feature.Results)
                .Where(result => result.LibraryId.Equals(library.Id, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            <article class="library-card">
                <div class="card-heading">
                    <span class="category-chip">@report.Category.Name</span>
                    <span class="card-heading-end">
                        <RatingBadge Category="@report.Category.Name"
                                     Rated="@(metadata?.Rated ?? false)"
                                     Standing="@Scoring.Standing(cardMedals, library.Id)"
                                     Place="@Scoring.Place(cardMedals, library.Id)"/>
                        @if (LibraryLink is { } link)
                        {
                            <CopyLinkButton Url="@link(library.Id)"/>
                        }
                        <span class="status-dot @(benchmarkResults.All(item => item.Successful) ? "ok" : "bad")"></span>
                    </span>
                </div>
                <div class="library-identity">
                    <LibraryLogo Source="@View.Logo(report, library.Id)"
                                 Name="@library.Name"/>
                    <div>
                        <h2>
                            <button class="library-open"
                                    type="button"
                                    title="@($"Open the {library.Name} overview")"
                                    @onclick="() => OnOpenLibrary.InvokeAsync(library.Id)">
                                @library.Name
                            </button>
                        </h2>
                        <p class="package">@library.Package · @library.Version</p>
                    </div>
                </div>
                @if (metadata is not null)
                {
                    <p class="library-description">@metadata.Description</p>
                    @if (LibraryUrl(metadata) is { } url)
                    {
                        <a class="library-link"
                           href="@url"
                           target="_blank"
                           rel="noreferrer">
                            @LibraryLinkLabel(metadata) ↗
                        </a>
                    }
                }
                <div class="metric-row">
                    <div><strong>@supported</strong><span>supported</span></div>
                    <div><strong>@unavailable</strong><span>unavailable</span></div>
                    <div><strong>@benchmarkResults.Length</strong><span>benchmarks</span></div>
                </div>
            </article>
        }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CategoryReport> Reports { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    [Parameter]
    public EventCallback<string> OnHelp { get; set; }

    /// <summary>Builds the shareable address of a library; the page owns the format.</summary>
    [Parameter]
    public Func<string, string>? LibraryLink { get; set; }

    private static string? LibraryUrl(MatrixLibraryMetadata metadata) =>
        metadata.DocumentationUrl ?? metadata.RepositoryUrl;

    private static string LibraryLinkLabel(MatrixLibraryMetadata metadata) =>
        metadata.DocumentationUrl is not null ? "Documentation" : "Repository";
}
