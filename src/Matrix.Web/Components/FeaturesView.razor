@inject IMatrixView View
@inject IMatrixScoring Scoring

@foreach (var report in Reports)
{
    var libraries = report.Features?.Libraries
        .Where(library => View.IsSelected(report, SelectedLibraries, library.Id))
        .ToArray() ?? [];
    if (libraries.Length == 0)
    {
        continue;
    }

    var features = report.Features!.Features
        .OrderBy(feature => feature.Order)
        .ToArray();
    <section class="panel report-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@report.Category.Name</p>
                <h2>Feature matrix</h2>
            </div>
            <span class="section-meta">@features.Length scenarios · @libraries.Length libraries</span>
        </div>
        <ul class="feature-legend">
            @foreach (var (status, label) in Legend)
            {
                <li>
                    <span class="feature-status @StatusClass(status)">
                        <StatusIcon Kind="@StatusClass(status)"/>
                    </span>
                    @label
                </li>
            }
            <li>
                <span class="feature-status supported has-reason">
                    <StatusIcon Kind="supported"/>
                </span>
                Has a note
            </li>
            <li>
                <span class="feature-status is-medal">
                    <RatingIcon Place="gold"/>
                </span>
                Fastest &amp; lightest here
            </li>
            <li>
                <NotRatedBadge Reason="Not part of the category rating"/>
                Not rated — still measured
            </li>
        </ul>
        <div class="table-scroll">
            <table class="feature-table">
                <thead>
                <tr>
                    <th>Feature</th>
                    @foreach (var library in libraries)
                    {
                        <th title="@($"{library.Name} {library.Version}")">
                            <span class="column-library">
                                <LibraryLogo Source="@View.Logo(report, library.Id)"
                                             Name="@library.Name"
                                             Size="sm"/>
                                <button class="library-open column-library-name"
                                        type="button"
                                        @onclick="() => OnOpenLibrary.InvokeAsync(library.Id)">
                                    @library.Name
                                </button>
                                <small>@library.Version</small>
                            </span>
                        </th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var feature in features)
                {
                    var description = View.FeatureDescription(report, feature.Id);
                    var notRatedReason = View.FeatureNotRatedReason(report, feature.Id);
                    var expanded = _expanded.Contains(feature.Id);
                    var medals = ScenarioMedals(report, feature, libraries);
                    <tr>
                        <th>
                            @if (description is null)
                            {
                                <span class="feature-order">@feature.Order.ToString("00")</span>
                                @feature.Name
                                @if (notRatedReason is not null)
                                {
                                    <NotRatedBadge Reason="@notRatedReason"/>
                                }
                            }
                            else
                            {
                                <button class="feature-toggle"
                                        type="button"
                                        aria-expanded="@(expanded ? "true" : "false")"
                                        title="@description"
                                        @onclick="() => Toggle(feature.Id)">
                                    <span class="feature-order">@feature.Order.ToString("00")</span>
                                    <span>@feature.Name</span>
                                    @if (notRatedReason is not null)
                                    {
                                        <NotRatedBadge Reason="@notRatedReason"/>
                                    }
                                    <span class="feature-toggle-mark" aria-hidden="true">
                                        @(expanded ? "−" : "?")
                                    </span>
                                </button>
                            }
                        </th>
                        @foreach (var library in libraries)
                        {
                            var value = feature.Results.FirstOrDefault(result =>
                                result.LibraryId.Equals(library.Id, StringComparison.OrdinalIgnoreCase));
                            var medal = medals.GetValueOrDefault(library.Id);
                            <td>
                                @* Fastest and lightest here replaces the checkmark rather
                                   than sitting above it: a star already says the scenario
                                   was supported, so the row stays as compact as the plain
                                   status grid. *@
                                @if (medal is not null)
                                {
                                    <span class="feature-status is-medal @(value is not null ? ReasonClass(value) : null)"
                                          title="@Tooltip(feature, library, value, medal)">
                                        <RatingIcon Place="@medal"/>
                                    </span>
                                }
                                else if (value is not null)
                                {
                                    <span class="feature-status @StatusClass(value.Status) @ReasonClass(value)"
                                          title="@Tooltip(feature, library, value, null)">
                                        <StatusIcon Kind="@StatusClass(value.Status)"/>
                                    </span>
                                }
                                else
                                {
                                    <span class="feature-status missing"
                                          title="@Tooltip(feature, library, null, null)">
                                        <StatusIcon Kind="missing"/>
                                    </span>
                                }
                            </td>
                        }
                    </tr>
                    @if (expanded && description is not null)
                    {
                        <tr class="feature-description-row">
                            <th colspan="@(libraries.Length + 1)">@description</th>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private static readonly (string Status, string Label)[] Legend =
    [
        ("Supported", "Supported"),
        ("Unsupported", "Unsupported"),
        ("NotApplicable", "Not applicable"),
        ("Failed", "Failed"),
        ("", "No data")
    ];

    [Parameter, EditorRequired]
    public required IReadOnlyList<CategoryReport> Reports { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    private void Toggle(string featureId)
    {
        if (!_expanded.Add(featureId))
        {
            _expanded.Remove(featureId);
        }
    }

    private static string Tooltip(
        FeatureReportEntry feature,
        MatrixLibrary library,
        FeatureResult? result,
        string? medal)
    {
        var head = result is null
            ? $"{library.Name} · {feature.Name}: no data"
            : $"{library.Name} · {feature.Name}: {StatusLabel(result.Status)}";
        if (result?.Reason is { } reason)
        {
            head = $"{head}\n{reason}";
        }

        return medal is null ? head : $"{head}\n{Ordinal(medal)} here on time and memory combined";
    }

    private static string ReasonClass(FeatureResult result) =>
        result.Reason is null ? string.Empty : "has-reason";

    private static string StatusClass(string status) => status switch
    {
        "Supported" => "supported",
        "Unsupported" => "unsupported",
        "NotApplicable" => "not-applicable",
        "Failed" => "failed",
        _ => "missing"
    };

    private static string StatusLabel(string status) =>
        status == "NotApplicable" ? "N/A" : status;

    private static readonly IReadOnlyDictionary<string, string> NoMedals =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Who placed on this one scenario, time and memory combined — the same rule
    /// the category rating scores with, run over a single benchmark entry instead
    /// of all of them. A scenario the benchmark report never measured, or one
    /// nobody selected scored anything on, gives out no medals.
    /// </summary>
    private IReadOnlyDictionary<string, string> ScenarioMedals(
        CategoryReport report,
        FeatureReportEntry feature,
        IReadOnlyList<MatrixLibrary> libraries)
    {
        var benchmark = report.Benchmarks?.Features.FirstOrDefault(entry =>
            entry.Id.Equals(feature.Id, StringComparison.OrdinalIgnoreCase));
        if (benchmark is null)
        {
            return NoMedals;
        }

        bool Include(string libraryId) =>
            View.IsRated(report, libraryId) && View.IsSelected(report, SelectedLibraries, libraryId);

        return libraries
            .Where(library => Include(library.Id))
            .Select(library => (library.Id, Points: ScenarioPoints(benchmark, library.Id, Include)))
            .Where(entry => entry.Points > 0)
            .OrderByDescending(entry => entry.Points)
            .Take(Scoring.Places)
            .Select((entry, index) => (entry.Id, Place: Medal(index)))
            .ToDictionary(entry => entry.Id, entry => entry.Place, StringComparer.OrdinalIgnoreCase);
    }

    private static double ScenarioPoints(
        BenchmarkReportEntry benchmark,
        string libraryId,
        Func<string, bool> includeLibrary)
    {
        var detail = MatrixScores.Explain([benchmark], libraryId, includeLibrary).FirstOrDefault();
        return detail is null ? 0 : detail.Time.Points + detail.Memory.Points;
    }

    private static string Medal(int index) => index switch
    {
        0 => "gold",
        1 => "silver",
        _ => "bronze"
    };

    private static string Ordinal(string medal) => medal switch
    {
        "gold" => "1st",
        "silver" => "2nd",
        _ => "3rd"
    };
}
