@if (!Rated)
{
    <span class="rating-badge is-unrated" title="@($"{Category}: not part of the rating")">
        <RatingIcon Place="unrated"/>
    </span>
}
else if (Standing is { } standing && Place is >= 1 and <= MatrixRatings.Places)
{
    @* One medal for the place in the category, not one per overview group: what
       a library won inside a group is stated by the stars on the chart rows. *@
    <span class="rating-badge" title="@Title(standing)">
        <RatingIcon Place="@Name(Place.Value)"/>
    </span>
}

@code {
    [Parameter]
    public MatrixMedals? Standing { get; set; }

    [Parameter]
    public int? Place { get; set; }

    [Parameter]
    public bool Rated { get; set; } = true;

    /// <summary>Named in every tooltip: the rating is per category.</summary>
    [Parameter, EditorRequired]
    public required string Category { get; set; }

    private string Title(MatrixMedals standing) =>
        $"{Category} · {Ordinal(Place!.Value)} place"
        + $" · {standing.Points} of {standing.Maximum} points";

    private static string Name(int place) => place switch
    {
        1 => "gold",
        2 => "silver",
        _ => "bronze"
    };

    private static string Ordinal(int place) => place switch
    {
        1 => "1st",
        2 => "2nd",
        _ => "3rd"
    };
}
