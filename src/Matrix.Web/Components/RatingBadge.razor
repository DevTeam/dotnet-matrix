@* Always rendered, and always the same size. An icon that appears only on the
   podium would otherwise move whatever sits beside it from row to row. One medal
   stands for the place in the category; what a library won inside a single group
   is stated by the stars on the chart rows. *@
<span class="rating-badge @Modifier" title="@Title">
    @if (!Rated)
    {
        <RatingIcon Place="unrated"/>
    }
    else if (Place is >= 1 and <= MatrixRatings.Places)
    {
        <RatingIcon Place="@Name(Place.Value)"/>
    }
</span>

@code {
    [Parameter]
    public MatrixMedals? Standing { get; set; }

    [Parameter]
    public int? Place { get; set; }

    [Parameter]
    public bool Rated { get; set; } = true;

    /// <summary>Named in every tooltip: the rating is per category.</summary>
    [Parameter, EditorRequired]
    public required string Category { get; set; }

    private string? Modifier => !Rated ? "is-unrated" : null;

    private string? Title => (Rated, Place, Standing) switch
    {
        (false, _, _) => $"{Category}: not part of the rating",
        (_, >= 1 and <= MatrixRatings.Places, { } standing) =>
            $"{Category} · {Ordinal(Place!.Value)} place"
            + $" · {MatrixScores.Format(standing.Points)} of {standing.Maximum} points",
        _ => null
    };

    private static string Name(int place) => place switch
    {
        1 => "gold",
        2 => "silver",
        _ => "bronze"
    };

    private static string Ordinal(int place) => place switch
    {
        1 => "1st",
        2 => "2nd",
        _ => "3rd"
    };
}
