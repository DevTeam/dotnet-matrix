@if (_overview is { } overview && _rows.Length > 0)
{
    var featureNames = overview.Features
        .Select(feature => MatrixView.FeatureDescription(Report, feature.Id) is { } text
            ? $"{feature.Name} — {text}"
            : feature.Name)
        .ToArray();
    <figure class="overview-chart">
        <figcaption class="overview-chart-head">
            <h3>@overview.Group.Name overview</h3>
            <p>
                @overview.Features.Count/@overview.Features.Count coverage required for ranking
                · lower is better
            </p>
            @* Once per report: the scale and the coverage rule are the same for
               every chart below. *@
            @if (OnHelp.HasDelegate)
            {
                <HelpButton Topic="overview" Label="How to read this chart" OnHelp="@OnHelp"/>
            }
        </figcaption>

        <div class="overview-chart-row overview-chart-columns">
            <div></div>
            <div class="overview-panel-head">
                <strong>Performance</strong>
                <small>total mean time</small>
            </div>
            <div class="overview-panel-head">
                <strong>Memory</strong>
                <small>total allocated</small>
            </div>
        </div>

        @for (var index = 0; index < _rows.Length; index++)
        {
            var item = _rows[index];
            @if (index == overview.Ranked.Count && overview.Unranked.Count > 0)
            {
                <p class="overview-chart-divider">
                    <span>Not ranked · partial coverage</span>
                </p>
            }
            <div class="overview-chart-row @(index % 2 == 0 ? "is-striped" : null)">
                @{
                    var mark = Mark(item);
                }
                <div class="overview-chart-label">
                    <span class="overview-chart-rank">@item.Rank</span>
                    <LibraryLogo Source="@MatrixView.Logo(Report, item.Row.LibraryId)"
                                 Name="@item.Row.Name"
                                 Size="sm"/>
                    <div>
                        <strong>
                            <button class="library-open"
                                    type="button"
                                    title="@($"Open the {item.Row.Name} overview")"
                                    @onclick="() => OnOpenLibrary.InvokeAsync(item.Row.LibraryId)">
                                @item.Row.Name
                            </button>
                        </strong>
                        @if (item.Coverage is not null)
                        {
                            <small>@item.Coverage</small>
                        }
                    </div>
                    @* Always rendered, so medals and the out-of-rating mark keep to
                       one column at the right edge of the label. *@
                    <span class="overview-chart-medal" title="@mark.Title">
                        @if (mark.Icon is { } icon)
                        {
                            <RatingIcon Place="@icon"/>
                        }
                    </span>
                </div>
                <OverviewBar Values="@item.Row.PerformanceValues"
                             FeatureNames="@featureNames"
                             Maximum="@overview.MaximumTime"/>
                <OverviewBar Values="@item.Row.MemoryValues"
                             FeatureNames="@featureNames"
                             Maximum="@overview.MaximumMemory"
                             Memory="true"/>
            </div>
        }

        <ul class="overview-chart-legend">
            @for (var index = 0; index < overview.Features.Count; index++)
            {
                var feature = overview.Features[index];
                <li title="@(MatrixView.FeatureDescription(Report, feature.Id) ?? feature.Name)">
                    <span class="overview-chart-swatch"
                          style="background: @MatrixChartPalette.Feature(index)"></span>
                    @feature.Name
                </li>
            }
        </ul>
    </figure>
}

@code {
    private MatrixOverview? _overview;
    private OverviewChartRowView[] _rows = [];

    [Parameter, EditorRequired]
    public required CategoryReport Report { get; set; }

    [Parameter, EditorRequired]
    public required MatrixChartGroup Group { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    [Parameter]
    public EventCallback<string> OnHelp { get; set; }

    protected override void OnParametersSet()
    {
        _overview = Report.Benchmarks is null
            ? null
            : MatrixOverviews.Create(
                Report.Benchmarks,
                Group,
                libraryId => MatrixView.IsSelected(Report, SelectedLibraries, libraryId));

        // The medal ranking drops libraries that are out of the rating, so a place
        // here does not have to match the row number of the chart.
        var places = _overview is null || Report.Benchmarks is null
            ? []
            : MatrixOverviews.Create(
                    Report.Benchmarks,
                    Group,
                    libraryId => MatrixView.IsRated(Report, libraryId)
                                 && MatrixView.IsSelected(Report, SelectedLibraries, libraryId))
                ?.Ranked
                .Take(MatrixRatings.Places)
                .Select((row, index) => (row.LibraryId, Place: PlaceName(index)))
                .ToDictionary(item => item.LibraryId, item => item.Place, StringComparer.OrdinalIgnoreCase)
            ?? [];

        _rows = _overview is null
            ? []
            : _overview.Ranked
                .Select((row, index) => new OverviewChartRowView(
                    row,
                    $"{index + 1}.",
                    null,
                    Place(places, row)))
                .Concat(_overview.Unranked.Select(row =>
                    new OverviewChartRowView(
                        row,
                        null,
                        Coverage(_overview, row),
                        Place(places, row))))
                .ToArray();
    }

    private static string? Place(
        IReadOnlyDictionary<string, string> places,
        MatrixOverviewRow row) =>
        places.GetValueOrDefault(row.LibraryId);

    private static string PlaceName(int index) => index switch
    {
        0 => "gold",
        1 => "silver",
        _ => "bronze"
    };

    /// <summary>
    /// A crossed star means the row could not win a medal here at all: either the
    /// library is out of the rating, or it does not cover the whole group.
    /// </summary>
    private (string? Icon, string? Title) Mark(OverviewChartRowView item)
    {
        if (!MatrixView.IsRated(Report, item.Row.LibraryId))
        {
            return ("unrated", $"{Report.Category.Name}: not part of the rating");
        }

        if (item.Place is { } place)
        {
            return (place, PlaceTitle(place));
        }

        return item.Coverage is null
            ? (null, null)
            : ("unrated",
                $"{Report.Category.Name}: not ranked in the {Group.Name} overview"
                + " — partial coverage");
    }

    private string PlaceTitle(string place) =>
        $"{Report.Category.Name} · {place} ({place switch
        {
            "gold" => "1st",
            "silver" => "2nd",
            _ => "3rd"
        }} place) in the {Group.Name} overview";

    private static string Coverage(MatrixOverview overview, MatrixOverviewRow row) =>
        $"{overview.Features.Count - row.MissingFeatures.Count}/{overview.Features.Count}"
        + $" · Missing: {string.Join(", ", row.MissingFeatures)}";
}
