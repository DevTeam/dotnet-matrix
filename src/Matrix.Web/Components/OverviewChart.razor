@using System.Globalization
@inject IMatrixView View
@inject IMatrixScoring Scoring
@inject IMatrixPalette Palette

@if (_overview is { Rows.Count: > 0 } overview)
{
    var featureNames = overview.Features
        .Select(feature => View.FeatureDescription(Report, feature.Id) is { } text
            ? $"{feature.Name} — {text}"
            : feature.Name)
        .ToArray();
    <figure class="overview-chart">
        <figcaption class="overview-chart-head">
            <h3>@overview.Group.Name overview</h3>
            <div class="section-head-end">
                <p class="section-note">
                    @overview.Features.Count scenario@(overview.Features.Count == 1 ? "" : "s")
                    · points out of @overview.Maximum · lower is better for the bars
                </p>
                @* Once per report: the scale and the scoring rule are the same for
                   every chart below. *@
                @if (OnHelp.HasDelegate)
                {
                    <HelpButton Topic="overview" Label="How to read this chart" OnHelp="@OnHelp"/>
                }
            </div>
        </figcaption>

        <div class="overview-chart-row overview-chart-columns">
            <div></div>
            <div class="overview-panel-head">
                <strong>Time</strong>
                <small>total mean time</small>
            </div>
            <div class="overview-panel-head">
                <strong>Memory</strong>
                <small>total allocated</small>
            </div>
            <div class="overview-panel-head is-points">
                <strong>Points</strong>
                <small>time + memory</small>
            </div>
            <div></div>
        </div>

        @for (var index = 0; index < overview.Rows.Count; index++)
        {
            var row = overview.Rows[index];
            var place = index + 1;
            var mark = Mark(row);
            @* The breakdown of the points is built when the pointer reaches the row
               rather than for every row in advance: see Reveal below. Bound to the
               row, so moving along one costs nothing. *@
            <div class="overview-chart-row @(index % 2 == 0 ? "is-striped" : null)"
                 style="--points-time: @Share(overview, row, row.TimePoints); --points: @Share(overview, row, row.Points)"
                 @onmouseenter="() => Reveal(row.LibraryId)">
                <div class="overview-chart-label">
                    @* A library outside the rating holds no place in it. *@
                    <span class="overview-chart-rank">@(row.Rated ? place.ToString() : "")</span>
                    <LibraryLogo Source="@View.Logo(Report, row.LibraryId)"
                                 Name="@row.Name"
                                 Size="sm"/>
                    <div>
                        <strong>
                            <button class="library-open"
                                    type="button"
                                    title="@($"Open the {row.Name} overview")"
                                    @onclick="() => OnOpenLibrary.InvokeAsync(row.LibraryId)">
                                @row.Name
                            </button>
                        </strong>
                        @* Shown on every row, as in the standings: it is what
                           explains a low score. *@
                        <small class="@(row.MissingFeatures.Count > 0 ? "is-partial" : null)"
                               title="@CoverageTitle(row)">
                            @Coverage(overview, row)
                        </small>
                    </div>
                </div>
                <OverviewBar Values="@row.PerformanceValues"
                             FeatureNames="@featureNames"
                             Maximum="@overview.MaximumTime"/>
                <OverviewBar Values="@row.MemoryValues"
                             FeatureNames="@featureNames"
                             Maximum="@overview.MaximumMemory"
                             Memory="true"/>
                <span class="overview-chart-points @(row.Rated ? null : "is-reference")"
                      title="@PointsTitle(overview, row)">
                    @* The heading is gone once the row stacks on a phone. *@
                    <span class="rating-label">Points</span>
                    @if (row.Rated)
                    {
                        @* As in the standings: the tooltip serves a pointer, the button
                           serves everyone else. *@
                        <button class="library-open"
                                type="button"
                                aria-label="@BreakdownLabel(overview, row)"
                                @onclick="() => OnOpenLibrary.InvokeAsync(row.LibraryId)">
                            @Scoring.Format(row.Points)
                        </button>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </span>
                @* Always rendered, so medals and the out-of-rating mark keep to
                   one column at the right edge of the row. *@
                <span class="overview-chart-medal" title="@mark.Title">
                    @if (mark.Icon is { } icon)
                    {
                        <RatingIcon Place="@icon"/>
                    }
                </span>
            </div>
        }

        <ul class="overview-chart-legend">
            @for (var index = 0; index < overview.Features.Count; index++)
            {
                var feature = overview.Features[index];
                <li title="@(View.FeatureDescription(Report, feature.Id) ?? feature.Name)">
                    <span class="overview-chart-swatch"
                          style="background: @Palette.Feature(index)"></span>
                    @feature.Name
                </li>
            }
        </ul>
    </figure>
}

@code {
    private MatrixOverview? _overview;
    private Dictionary<string, string> _places = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired]
    public required CategoryReport Report { get; set; }

    [Parameter, EditorRequired]
    public required MatrixChartGroup Group { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    [Parameter]
    public EventCallback<string> OnHelp { get; set; }

    protected override void OnParametersSet()
    {
        _overview = View.Overview(Report, Group, SelectedLibraries);

        // Medals ignore libraries that are out of the rating, so a place here does
        // not have to match the row number of the chart.
        _places = _overview is null
            ? []
            : View.RatedOverview(Report, Group, SelectedLibraries)
                ?.Rows
                .Take(Scoring.Places)
                .Select((row, index) => (row.LibraryId, Place: PlaceName(index)))
                .ToDictionary(item => item.LibraryId, item => item.Place, StringComparer.OrdinalIgnoreCase)
            ?? [];
    }

    private static string PlaceName(int index) => index switch
    {
        0 => "gold",
        1 => "silver",
        _ => "bronze"
    };

    /// <summary>
    /// A crossed star means the row cannot win a medal here: the library is out of
    /// the rating. Everything else either medalled or simply placed lower.
    /// </summary>
    private (string? Icon, string? Title) Mark(MatrixOverviewRow row)
    {
        if (!row.Rated)
        {
            return ("unrated",
                $"{Report.Category.Name}: a reference, not part of the rating."
                + " It scores nothing and does not set the best result");
        }

        return _places.GetValueOrDefault(row.LibraryId) is { } medal
            ? (medal, PlaceTitle(medal))
            : (null, null);
    }

    /// <summary>
    /// Which row's breakdown has been asked for, if any. A chart draws one per row
    /// and a report draws a chart per group, so building them all in advance cost
    /// more than everything else on the page put together.
    /// </summary>
    private string? _revealed;

    private void Reveal(string libraryId) => _revealed = libraryId;

    /// <summary>
    /// Says the number and where the arithmetic behind it is, because the cell around
    /// it can only say the number.
    /// </summary>
    private string BreakdownLabel(MatrixOverview overview, MatrixOverviewRow row) =>
        $"{row.Name}: {Scoring.Format(row.Points)} of {overview.Maximum} points"
        + $" in the {Group.Name} overview."
        + " Open the overview for the points of every scenario";

    /// <summary>
    /// The measurements this row was summed from, over the scenarios of this group
    /// only — the same breakdown the standings give for the whole category. Built
    /// only for the row the pointer is on; the note for a reference row is a
    /// constant and is always there.
    /// </summary>
    private string? PointsTitle(MatrixOverview overview, MatrixOverviewRow row)
    {
        if (!row.Rated)
        {
            return "Outside the rating: shown as a reference only";
        }

        return row.LibraryId.Equals(_revealed, StringComparison.OrdinalIgnoreCase)
            ? Scoring.Hint(Report, overview.Features, SelectedLibraries, row.LibraryId, null)
            : null;
    }

    private string PlaceTitle(string place) =>
        $"{Report.Category.Name} · {place} ({place switch
        {
            "gold" => "1st",
            "silver" => "2nd",
            _ => "3rd"
        }} place) in the {Group.Name} overview";

    private static string Coverage(MatrixOverview overview, MatrixOverviewRow row) =>
        $"{overview.Features.Count - row.MissingFeatures.Count}/{overview.Features.Count}";

    /// <summary>
    /// The share of the group maximum a value holds, as the width of its fill.
    /// A reference row is out of the rating and scores nothing, so its fill stays
    /// empty rather than showing a share it never competed for.
    /// </summary>
    private static string Share(MatrixOverview overview, MatrixOverviewRow row, double points) =>
        row.Rated && overview.Maximum > 0
            ? (100d * points / overview.Maximum).ToString("0.##", CultureInfo.InvariantCulture) + "%"
            : "0%";

    private static string CoverageTitle(MatrixOverviewRow row) =>
        row.MissingFeatures.Count == 0
            ? "Completed every scenario of this group"
            : $"Missing: {string.Join(", ", row.MissingFeatures)}."
              + " Each of them scores nothing";
}
