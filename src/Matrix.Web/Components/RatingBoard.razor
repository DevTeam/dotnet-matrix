@using System.Globalization
@inject IMatrixView View
@inject IMatrixScoring Scoring
@if (Medals.Count > 0)
{
    var scale = Medals[0];
    <section class="rating-board">
        <div class="rating-board-head">
            <div>
                <p class="eyebrow">Rating</p>
                <h3>Standings</h3>
            </div>
            <div class="section-head-end">
                @* The scale is stated in the open: a number nobody can place is
                   worse than no number. *@
                <p class="section-note">points out of @scale.Maximum</p>
                <HelpButton Topic="rating" Label="How the rating is computed" OnHelp="@OnHelp"/>
            </div>
        </div>
        @* A table, and a fixed one: every cell is always present, so a medal or a
           coverage note can never shift the column it sits in. *@
        <div class="rating-table">
            <table>
                <thead>
                <tr>
                    <th class="rating-column-place">#</th>
                    <th class="rating-column-name">Library</th>
                    <th>Scenarios</th>
                    <th>Time</th>
                    <th>Memory</th>
                    <th>Points</th>
                </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Medals.Count; index++)
                {
                    var item = Medals[index];
                    var place = index + 1;
                    @* Bound to the row rather than to the three cells that carry a
                       breakdown, so moving along a row costs no render. *@
                    <tr style="--points: @Share(item)"
                        @onmouseenter="() => Reveal(item.LibraryId)">
                        <td class="rating-column-place">@place</td>
                        <td class="rating-column-name">
                            <span class="rating-name">
                                <LibraryLogo Source="@View.Logo(Report, item.LibraryId)"
                                             Name="@item.Name"
                                             Size="sm"/>
                                <button class="library-open"
                                        type="button"
                                        title="@($"Open the {item.Name} overview")"
                                        @onclick="() => OnOpenLibrary.InvokeAsync(item.LibraryId)">
                                    @item.Name
                                </button>
                                <RatingBadge Standing="@item"
                                             Place="@place"
                                             Category="@Report.Category.Name"/>
                            </span>
                        </td>
                        @* The labels repeat the column headings and show only where
                           the table stacks and the headings are gone. *@
                        <td class="@(item.Covered < item.Scenarios ? "is-partial" : null)"
                            title="@Coverage(item)">
                            <span class="rating-label">Scenarios</span>@item.Covered/@item.Scenarios
                        </td>
                        @* Every points cell carries the measurements it was summed
                           from, so the number can be checked without leaving the row.
                           The text is built when the pointer reaches the row rather
                           than for every row in advance: see Reveal below. *@
                        <td class="rating-column-score" title="@Hint(item, false)">
                            <span class="rating-label">Time</span>@Scoring.Format(item.TimePoints)
                        </td>
                        <td class="rating-column-score" title="@Hint(item, true)">
                            <span class="rating-label">Memory</span>@Scoring.Format(item.MemoryPoints)
                        </td>
                        <td class="rating-column-total" title="@Hint(item, null)">
                            <span class="rating-label">Points</span>@Scoring.Format(item.Points)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public required CategoryReport Report { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<MatrixMedals> Medals { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    [Parameter]
    public EventCallback<string> OnHelp { get; set; }

    /// <summary>
    /// Which row's breakdown has been asked for, if any. Not part of the comparison
    /// and not worth a parameter: it lives and dies with the pointer.
    /// </summary>
    private string? _revealed;

    /// <summary>
    /// A breakdown is one line of arithmetic per scenario per metric, and the
    /// standings hold three of them for every library — twenty-three rows of the
    /// Dependency Injection category came to a hundred and thirty-eight breakdowns
    /// built on every render, of which a visitor reads at most one. Building the
    /// text when the pointer arrives instead took a filter change on that category
    /// from some 900 ms to 250 ms. The native tooltip appears about half a second
    /// after the pointer settles, so the row it belongs to is re-rendered long
    /// before the browser asks for the attribute.
    /// </summary>
    private void Reveal(string libraryId) => _revealed = libraryId;

    private string? Hint(MatrixMedals item, bool? metric) =>
        Report.Benchmarks is { } benchmarks
        && item.LibraryId.Equals(_revealed, StringComparison.OrdinalIgnoreCase)
            ? Scoring.Hint(
                Report,
                benchmarks.Features,
                SelectedLibraries,
                item.LibraryId,
                metric)
            : null;

    /// <summary>
    /// The share of the maximum this row holds, as the width of its fill.
    /// Invariant, because a decimal comma is not a CSS length.
    /// </summary>
    private static string Share(MatrixMedals item) =>
        item.Maximum > 0
            ? (100d * item.Points / item.Maximum).ToString("0.##", CultureInfo.InvariantCulture) + "%"
            : "0%";

    private static string Coverage(MatrixMedals item) =>
        item.Covered < item.Scenarios
            ? $"Completed {item.Covered} of {item.Scenarios} scenarios;"
              + " the rest score nothing"
            : "Completed every scenario";
}
