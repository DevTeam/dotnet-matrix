@if (Medals.Count > 0)
{
    var maximum = Medals[0].Maximum;
    <section class="rating-board">
        <div class="rating-board-head">
            <div>
                <p class="eyebrow">Rating</p>
                <h3>Standings</h3>
            </div>
            @* The scale is stated in the open: a number nobody can place is
               worse than no number. *@
            <span class="section-meta">points out of @maximum</span>
            <HelpButton Topic="rating" Label="How the rating is computed" OnHelp="@OnHelp"/>
        </div>
        <ol class="rating-board-list">
            @for (var index = 0; index < Medals.Count; index++)
            {
                var item = Medals[index];
                <li>
                    <span class="rating-place">@(index + 1)</span>
                    <LibraryLogo Source="@MatrixView.Logo(Report, item.LibraryId)"
                                 Name="@item.Name"
                                 Size="sm"/>
                    <span class="rating-name">
                        <button class="library-open"
                                type="button"
                                title="@($"Open the {item.Name} overview")"
                                @onclick="() => OnOpenLibrary.InvokeAsync(item.LibraryId)">
                            @item.Name
                        </button>
                    </span>
                    @if (item.Covered < item.Scenarios)
                    {
                        @* Explains a low score without changing the order. *@
                        <span class="rating-coverage"
                              title="@($"Completed {item.Covered} of {item.Scenarios} scenarios; the rest score nothing")">
                            @item.Covered/@item.Scenarios
                        </span>
                    }
                    <span class="rating-points">@item.Points</span>
                    <RatingBadge Standing="@item"
                                 Place="@(index + 1)"
                                 Category="@Report.Category.Name"/>
                </li>
            }
        </ol>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public required CategoryReport Report { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<MatrixMedals> Medals { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenLibrary { get; set; }

    [Parameter]
    public EventCallback<string> OnHelp { get; set; }
}
