@if (Features.Length == 0)
{
    <EmptyState Title="No benchmark data" Text="No benchmark report is available for this selection."/>
}
else
{
    @foreach (var report in Reports)
    {
        var scenario = report.Benchmarks?.Features
            .FirstOrDefault(feature => feature.Id == SelectedFeature);
        if (report.Benchmarks is null || scenario is null)
        {
            continue;
        }

        var values = MatrixScenarios
            .Create(
                report.Benchmarks,
                scenario,
                libraryId => MatrixView.IsSelected(report, SelectedLibraries, libraryId))
            .Where(row => MatrixScenarios.Value(row, Memory) is not null)
            .ToArray();
        if (values.Length == 0)
        {
            continue;
        }

        var environmentGroups = values
            .GroupBy(value => value.EnvironmentId ?? "unknown", StringComparer.Ordinal)
            .ToArray();

        <section class="panel report-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">@report.Category.Name</p>
                    <h2>@(Memory ? "Allocated memory" : "Execution time")</h2>
                </div>
                <span class="section-meta">@(Memory ? "bytes / operation" : "mean")</span>
            </div>
                @if (environmentGroups.Length > 1)
                {
                    <div class="notice warning">
                        Results were produced in different environments and are separated below.
                    </div>
                }
                <div class="benchmark-list">
                    @foreach (var environmentGroup in environmentGroups)
                    {
                        var ordered = MatrixScenarios.Order(environmentGroup, Memory);
                        var minimum = MatrixScenarios.Minimum(ordered, Memory);
                        var maximum = MatrixScenarios.Maximum(ordered, Memory);
                        @if (environmentGroups.Length > 1)
                        {
                            <div class="benchmark-environment">Environment @environmentGroup.Key</div>
                        }
                        @foreach (var value in ordered)
                        {
                            var current = MatrixScenarios.Value(value, Memory)!.Value;
                            <div class="benchmark-row">
                                <div class="benchmark-name">
                                    <LibraryLogo Source="@MatrixView.Logo(report, value.LibraryId)"
                                                 Name="@value.Name"
                                                 Size="sm"/>
                                    <div>
                                        <strong>@value.Name</strong>
                                        <span>@MatrixMetrics.Ratio(current, minimum)</span>
                                    </div>
                                </div>
                                <div class="meter">
                                    <span class="@(Memory ? "is-memory" : "is-performance")"
                                          style="@MeterStyle(MatrixMetrics.ScalePercent(current, maximum))"></span>
                                </div>
                                <div class="benchmark-value">
                                    <strong>@MatrixMetrics.Format(current, Memory)</strong>
                                    @if (!Memory && value.TimeStandardError is not null)
                                    {
                                        <span>± @MatrixMetrics.FormatTime(value.TimeStandardError.Value)</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
        </section>
    }
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CategoryReport> Reports { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlySet<string> SelectedLibraries { get; set; }

    [Parameter]
    public bool Memory { get; set; }

    /// <summary>The scenario chosen in the list above the split.</summary>
    [Parameter]
    public string? Feature { get; set; }

    private string? SelectedFeature => Feature;

    private (string Id, string Name, int Order)[] Features =>
        Reports
            .SelectMany(report => report.Benchmarks?.Features ?? [])
            .Select(feature => (feature.Id, feature.Name, feature.Order))
            .Distinct()
            .OrderBy(feature => feature.Order)
            .ToArray();

    private static string MeterStyle(double percent) =>
        $"width: {percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
}
