@inject IJSRuntime JsRuntime

@* The clipboard is reached through the interop that Blazor already loads, so the
   application still ships no JavaScript of its own. *@
<button class="copy-link @(Caption is null ? "is-icon" : null)"
        type="button"
        title="@Title"
        aria-label="@(Caption ?? Title)"
        @onclick="CopyAsync"
        @onclick:stopPropagation="true">
    <svg viewBox="0 0 16 16"
         fill="none"
         stroke="currentColor"
         stroke-width="1.6"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true"
         focusable="false">
        @if (_state == CopyState.Copied)
        {
            <path d="M3.2 8.4l3.1 3.1 6.5-7"/>
        }
        else
        {
            <path d="M6.6 9.4a2.7 2.7 0 0 0 3.9 0l2.1-2.1a2.7 2.7 0 0 0-3.9-3.9l-.8.8"/>
            <path d="M9.4 6.6a2.7 2.7 0 0 0-3.9 0L3.4 8.7a2.7 2.7 0 0 0 3.9 3.9l.8-.8"/>
        }
    </svg>
    @if (Caption is { } caption)
    {
        <span>@(_state switch
               {
                   CopyState.Copied => "Copied",
                   CopyState.Failed => "Copy failed",
                   _ => caption
               })</span>
    }
</button>

@code {
    private enum CopyState
    {
        Idle,
        Copied,
        Failed
    }

    private CopyState _state;
    private int _generation;

    [Parameter, EditorRequired]
    public required string Url { get; set; }

    /// <summary>The visible label; without it the button is the icon alone.</summary>
    [Parameter]
    public string? Caption { get; set; }

    private string Title => _state switch
    {
        CopyState.Copied => $"Copied: {Url}",
        CopyState.Failed => $"The browser refused to write to the clipboard: {Url}",
        _ => $"Copy link: {Url}"
    };

    private async Task CopyAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Url);
            _state = CopyState.Copied;
        }
        catch (JSException)
        {
            // Denied permission, or an insecure origin where the API is absent.
            // The address stays in the tooltip, so the link is not lost.
            _state = CopyState.Failed;
        }

        // Blazor renders when the handler yields and when it completes, and both
        // moments are outside the window this state lives in.
        StateHasChanged();

        // The label goes back to resting on its own: a dialog left open for a
        // minute should not keep claiming something was just copied.
        var generation = ++_generation;
        await Task.Delay(1800);
        if (generation == _generation)
        {
            _state = CopyState.Idle;
            StateHasChanged();
        }
    }
}
