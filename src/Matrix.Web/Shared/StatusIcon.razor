<svg class="status-icon"
     viewBox="0 0 16 16"
     fill="none"
     stroke="currentColor"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @switch (Kind)
    {
        case "supported":
            <path d="M3.4 8.6l3.2 3.2 6-6.6" stroke-width="2"/>
            break;
        case "unsupported":
            <path d="M4.6 4.6l6.8 6.8M11.4 4.6l-6.8 6.8" stroke-width="2"/>
            break;
        case "not-applicable":
            <circle cx="8" cy="8" r="5.6" stroke-width="1.8"/>
            <path d="M4.1 11.9L11.9 4.1" stroke-width="1.8"/>
            break;
        case "failed":
            <path d="M8 2.5l6 11H2z" stroke-width="1.7"/>
            <path d="M8 6.6v2.9" stroke-width="1.7"/>
            <circle cx="8" cy="11.6" r="0.95" fill="currentColor" stroke="none"/>
            break;
        default:
            <path d="M4 8h.01M8 8h.01M12 8h.01" stroke-width="2.2"/>
            break;
    }
</svg>

@code {
    /// <summary>
    /// The status name already mapped to its CSS modifier by the caller,
    /// so the status-to-appearance mapping stays in one place.
    /// </summary>
    [Parameter, EditorRequired]
    public required string Kind { get; set; }
}
