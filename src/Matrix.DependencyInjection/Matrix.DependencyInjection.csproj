            <MatrixLogo>logos/singularity.png</MatrixLogo>
        </PackageReference>
        <PackageReference Include="Spring.Aop" Version="3.0.3"/>
        <PackageReference Include="Spring.Core" Version="3.0.3">
            <MatrixLibraryId>Spring</MatrixLibraryId>
            <MatrixLibraryName>Spring.NET</MatrixLibraryName>
            <MatrixCodeName>Spring</MatrixCodeName>
            <MatrixDescription>The Spring.NET application framework and its XML or code configured object factory.</MatrixDescription>
            <MatrixDocumentationUrl>https://www.springframework.net/</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/spring-projects/spring-net</MatrixRepositoryUrl>
            <MatrixLogo>logos/spring.png</MatrixLogo>
