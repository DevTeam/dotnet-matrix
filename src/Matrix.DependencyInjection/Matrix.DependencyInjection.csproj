        <PackageReference Include="Maestro" Version="3.6.6">
            <MatrixLibraryId>Maestro</MatrixLibraryId>
            <MatrixLibraryName>Maestro</MatrixLibraryName>
            <MatrixCodeName>Maestro</MatrixCodeName>
