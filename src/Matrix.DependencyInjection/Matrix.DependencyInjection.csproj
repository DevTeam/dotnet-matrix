        </PackageReference>
        <PackageReference Include="Ninject.Extensions.Interception" Version="3.3.5"/>
        <PackageReference Include="Ninject.Extensions.Interception.DynamicProxy" Version="3.3.5"/>
        <PackageReference Include="Singularity" Version="0.18.0">
            <MatrixLibraryId>Singularity</MatrixLibraryId>
            <MatrixLibraryName>Singularity</MatrixLibraryName>
            <MatrixCodeName>Singularity</MatrixCodeName>
