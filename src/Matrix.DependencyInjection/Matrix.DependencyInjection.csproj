            <MatrixDocumentationUrl>https://github.com/DevTeam/Pure.DI#readme</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/DevTeam/Pure.DI</MatrixRepositoryUrl>
            <MatrixLogo>logos/pure-di.png</MatrixLogo>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10">
            <MatrixLibraryId>Microsoft.DI</MatrixLibraryId>
            <MatrixLibraryName>Microsoft Extensions Dependency Injection</MatrixLibraryName>
            <MatrixCodeName>MicrosoftDi</MatrixCodeName>
            <MatrixDescription>The built-in .NET dependency injection container and its service collection abstractions.</MatrixDescription>
            <MatrixDocumentationUrl>https://learn.microsoft.com/dotnet/core/extensions/dependency-injection</MatrixDocumentationUrl>
            <MatrixRepositoryUrl>https://github.com/dotnet/dotnet</MatrixRepositoryUrl>
            <MatrixLogo>logos/microsoft-di.png</MatrixLogo>
        </PackageReference>
        <PackageReference Include="Autofac" Version="9.3.1">
