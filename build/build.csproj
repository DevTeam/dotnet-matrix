<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RazorCompileOnBuild>true</RazorCompileOnBuild>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\Matrix\Matrix.csproj"/>
        <PackageReference Include="CSharpInteractive" Version="1.2.3"/>
        <!-- CSharpInteractive 1.2.3 pins Microsoft.CodeAnalysis.Scripting 5.0.0, while BenchmarkDotNet
             0.16 requires Microsoft.CodeAnalysis.CSharp 5.6.0. Lifting the scripting stack to 5.6.0 keeps
             one Roslyn version in the closure instead of letting MSBuild fail with NU1107. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.6.0"/>
        <PackageReference Include="Pure.DI" Version="2.5.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SkiaSharp" Version="4.157.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.157.0" />
        <PackageReference Include="Svg.Skia" Version="5.2.3" />
        <PackageReference Include="System.CommandLine" Version="3.0.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <InternalsVisibleTo Include="Matrix.Tests"/>
    </ItemGroup>

</Project>
