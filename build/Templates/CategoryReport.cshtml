@model Build.Targets.CategoryReportModel
@{
    var category = Model.Category;
    var leader = category.Rating.FirstOrDefault();
    var additionalOverviewCount = Math.Max(0, category.Overviews.Count - 1);
}
<!-- Generated by build/Templates/CategoryReport.cshtml. Do not edit this file directly. -->

[← .NET Matrix](../../README.md) · [Open the interactive matrix →](@(Model.ApplicationUrl)?category=@category.Id)

# @category.Name

@if (leader is not null)
{
<blockquote>
<strong><a href="@(Model.ApplicationUrl)?category=@category.Id&amp;library=@leader.Id">@leader.Name</a></strong> leads the current rating · @category.Libraries.Count libraries · @category.Features.Count scenarios
</blockquote>
}
else
{
<blockquote>
@category.Libraries.Count libraries · @category.Features.Count scenarios · not currently rated
</blockquote>
}

@if (category.Rating.Count > 0)
{
<text>
## Rating

In every scenario the fastest library scores 100 points and the one allocating
least scores 100 more; four times slower is half the points, and an unsupported
scenario is worth nothing. Time and memory reach **@(category.Rating[0].MetricMaximum)**
each here, so the maximum is **@(category.Rating[0].Maximum)**.
See [workflows/rating.md](../../workflows/rating.md).

@if (category.RatingChart is not null)
{
<text>[![@category.Name rating](@category.RatingChart.Path)](@(Model.ApplicationUrl)?category=@category.Id)

</text>
}
| # | Library | Scenarios | Time | Memory | Points | Group wins |
|---:|---|---:|---:|---:|---:|---|
@foreach (var item in category.Rating)
{
<text>| @item.Place | [**@item.Name**](@(Model.ApplicationUrl)?category=@category.Id&library=@item.Id) | @item.Covered/@item.Scenarios | @item.TimePoints | @item.MemoryPoints | @item.Points | @item.Awards |
</text>
}

</text>
<details>
<summary><strong>How the points were earned</strong> — every scenario, with the measurements behind it</summary>

Each row is one scenario. `Best` is the lowest result among the rated libraries
that completed it, and the points follow from the two figures beside them:
`100 × √((best + step) / (result + step))`, with a step of 1 ns for time and 24 B
for memory. A dash means the library did not complete the scenario, and it scores
nothing for it. Add the two Points columns over every scenario and you get the
rating above. The same breakdown appears as a hint on any points value in the
[application](@(Model.ApplicationUrl)?category=@category.Id).

@foreach (var item in category.Rating)
{
<text>#### @item.Place. @item.Name — @item.Points of @item.Maximum

| Scenario | Time | Best | Points | Memory | Best | Points |
|---|---:|---:|---:|---:|---:|---:|
</text>
    foreach (var score in item.Breakdown)
    {
<text>| @score.Scenario | @score.Time | @score.TimeBest | @score.TimePoints | @score.Memory | @score.MemoryBest | @score.MemoryPoints |
</text>
    }
<text>
</text>
}
</details>

<text>
</text>
}
## Benchmark overview

@if (category.Overviews.Count > 0)
{
    var primaryOverview = category.Overviews[0];
<text>**@primaryOverview.Name**

![@category.Name @primaryOverview.Name benchmark overview](@primaryOverview.Path)

</text>
}
@if (additionalOverviewCount > 0)
{
<details>
<summary><strong>More overview charts (@additionalOverviewCount)</strong></summary>

@foreach (var chart in category.Overviews.Skip(1))
{
<text>#### @chart.Name

![@category.Name @chart.Name benchmark overview](@chart.Path)

</text>
}
</details>
}

## Compared libraries (@category.Libraries.Count)

<table>
@foreach (var library in category.Libraries)
{
<tr>
<td width="64"><img src="@library.Logo" width="48" height="48" alt="@library.Name logo"></td>
<td><strong>@if (library.Url is not null)
{<a href="@library.Url">@library.Name</a>}
else
{@library.Name}</strong>@if (!string.IsNullOrWhiteSpace(library.Version))
{<text> @library.Version</text>}<br>@library.Description</td>
<td width="100" align="right"><a href="@(Model.ApplicationUrl)?category=@category.Id&amp;library=@library.Id">Compare →</a></td>
</tr>
}
</table>

## Benchmark scenarios (@category.Features.Count)

@foreach (var feature in category.Features)
{
<text>### @feature.Order.ToString("00") · @feature.Name

@if (feature.Description is not null)
{
<text>@feature.Description

</text>
}
@if (feature.NotRatedReason is not null)
{
<text>*Not rated: @feature.NotRatedReason*

</text>
}
![@category.Name @feature.Name benchmark](@feature.ChartPath)

</text>
}
