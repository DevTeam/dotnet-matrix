<strong><a href="@(Model.ApplicationUrl)?category=@category.Id&amp;library=@leader.Id">@leader.Name</a></strong> leads the current rating · @category.Libraries.Count libraries · @category.Features.Count scenarios
</blockquote>
}
else
{
<blockquote>
@category.Libraries.Count libraries · @category.Features.Count scenarios · not currently rated
</blockquote>
}

@if (category.RatingChart is not null)
