@model Build.Targets.ReadmeModel
# .NET Matrix

> [**Open the interactive .NET Matrix →**](@Model.ApplicationUrl)

Evidence-based feature and performance comparisons for .NET libraries.

@foreach (var category in Model.Categories)
{
<text>
## @category.Name

@if (category.Rating.Count > 0)
{
<text>### Rating

A gold, silver and bronze star for the first three places of every benchmark overview.

| # | Library | 🥇 | 🥈 | 🥉 | Won |
|---|---|---|---|---|---|
@foreach (var item in category.Rating)
{
<text>| @item.Place | @item.Name | @(item.Gold == 0 ? "" : item.Gold.ToString()) | @(item.Silver == 0 ? "" : item.Silver.ToString()) | @(item.Bronze == 0 ? "" : item.Bronze.ToString()) | @item.Awards |
</text>
}

</text>
}
### Benchmark overview

Performance and allocated memory are shown together. Lower values are better.

@foreach (var chart in category.Overviews)
{
<text>![@category.Name @chart.Name benchmark overview](@chart.Path)

</text>
}
### Libraries

<table>
@foreach (var library in category.Libraries)
{
<tr>
<td width="64"><img src="@library.Logo" width="48" height="48" alt="@library.Name logo"></td>
<td><strong>@if (library.Url is not null)
{<a href="@library.Url">@library.Name</a>}
else
{@library.Name}</strong>@if (!string.IsNullOrWhiteSpace(library.Version))
{<text> @library.Version</text>}<br>@library.Description</td>
</tr>
}
</table>

### Benchmark scenarios

@foreach (var feature in category.Features)
{
<details>
<summary><strong>@feature.Order.ToString("00") · @feature.Name</strong></summary>

@if (feature.Description is not null)
{
<text>@feature.Description

</text>
}
![@category.Name @feature.Name benchmark](@feature.ChartPath)

</details>

}
</text>
}
